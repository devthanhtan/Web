@model QuanLiKhoaHocTrucTuyen.Services.Interfaces.InstructorReportDto
@using System.Text.Json
@{
    ViewData["Title"] = "Thống kê Giảng viên";
    ViewData["AreaTitle"] = "Kênh Giảng viên";
    var labelsJson = JsonSerializer.Serialize(Model.Buckets.Select(b => b.Label));
    var revenueJson = JsonSerializer.Serialize(Model.Buckets.Select(b => b.InstructorAmount));
    var enrollsJson = JsonSerializer.Serialize(Model.Buckets.Select(b => b.NewEnrollments));
}

<section class="hl-section pt-0">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4" data-reveal="up">
        <div>
            <div class="hl-eyebrow mb-2">
                <i class="bi bi-graph-up-arrow me-1"></i> HUIT Learning · Kênh Giảng viên
            </div>
            <h1 class="h3 fw-bold mb-1">Thống kê doanh thu &amp; học viên</h1>
            <p class="text-muted small mb-0">Theo dõi hiệu quả giảng dạy, tiến độ học viên và doanh thu ròng trên HUIT Learning</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <div class="btn-group" role="group" aria-label="Chu kỳ thống kê">
                <a asp-action="Index" asp-route-period="week"
                   class="btn @(Model.Period == "week" ? "btn-huit" : "btn-outline-huit") d-inline-flex align-items-center"
                   style="min-height: 44px;">Theo tuần</a>
                <a asp-action="Index" asp-route-period="month"
                   class="btn @(Model.Period == "month" ? "btn-huit" : "btn-outline-huit") d-inline-flex align-items-center"
                   style="min-height: 44px;">Theo tháng</a>
            </div>
            <a asp-area="Instructor" asp-controller="Courses" asp-action="Create"
               class="btn btn-orange d-inline-flex align-items-center px-3"
               style="min-height: 44px;">
                <i class="bi bi-plus-lg me-1"></i> Tạo khóa học mới
            </a>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4" data-stagger-group>
        <div class="col" data-reveal="up">
            <div class="hl-bento-card stat-card h-100 p-3 p-md-4">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div class="min-w-0">
                        <div class="small text-muted fw-medium">Doanh thu ròng cá nhân</div>
                        <div class="fs-4 fw-bold text-orange mt-1 text-nowrap">@Model.TotalNetRevenue.ToString("N0") đ</div>
                        <div class="small text-muted mt-1">Sau khấu trừ chiết khấu sàn</div>
                    </div>
                    <div class="stat-icon flex-shrink-0"><i class="bi bi-cash-coin"></i></div>
                </div>
            </div>
        </div>
        <div class="col" data-reveal="up">
            <div class="hl-bento-card stat-card h-100 p-3 p-md-4">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div class="min-w-0">
                        <div class="small text-muted fw-medium">Tổng lượt ghi danh</div>
                        <div class="fs-3 fw-bold text-huit mt-1" data-count-to="@Model.TotalStudents">@Model.TotalStudents</div>
                        <div class="small text-muted mt-1">học viên đang theo học</div>
                    </div>
                    <div class="stat-icon flex-shrink-0"><i class="bi bi-people-fill"></i></div>
                </div>
            </div>
        </div>
        <div class="col" data-reveal="up">
            <div class="hl-bento-card stat-card h-100 p-3 p-md-4">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div class="min-w-0">
                        <div class="small text-muted fw-medium">Đánh giá trung bình</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@(Model.AverageRating > 0 ? $"{Model.AverageRating:0.0} ★" : "Chưa có")</div>
                        <div class="small text-muted mt-1">từ phản hồi học viên</div>
                    </div>
                    <div class="stat-icon flex-shrink-0"><i class="bi bi-star-fill"></i></div>
                </div>
            </div>
        </div>
        <div class="col" data-reveal="up">
            <div class="hl-bento-card stat-card h-100 p-3 p-md-4">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div class="min-w-0">
                        <div class="small text-muted fw-medium">Hỏi đáp chờ trả lời</div>
                        <div class="fs-3 fw-bold text-dark mt-1" data-count-to="@Model.UnreadQna">@Model.UnreadQna</div>
                        <div class="small text-muted mt-1">Khóa công khai: <strong class="text-huit">@Model.ApprovedCourses/@Model.TotalCourses</strong></div>
                    </div>
                    <div class="stat-icon flex-shrink-0"><i class="bi bi-chat-dots-fill"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="hl-bento-card p-3 p-md-4 mb-4" data-reveal="up">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-3">
            <div>
                <div class="hl-eyebrow mb-1">Phân tích xu hướng</div>
                <h2 class="h5 fw-bold mb-0">
                    <i class="bi bi-bar-chart-line text-orange me-1"></i>
                    Biểu đồ doanh thu &amp; đăng ký mới (@(Model.Period == "week" ? "Theo tuần" : "Theo tháng"))
                </h2>
            </div>
            <a asp-area="Instructor" asp-controller="Qna" asp-action="Index" asp-route-unansweredOnly="true"
               class="btn btn-outline-huit d-inline-flex align-items-center"
               style="min-height: 44px;">
                <i class="bi bi-inbox me-2"></i> Hộp thư hỏi đáp
                <span class="badge badge-orange ms-2">@Model.UnreadQna</span>
            </a>
        </div>
        <div style="position: relative; min-height: 280px;">
            <canvas id="instructorChart"></canvas>
        </div>
    </div>

    <div class="hl-bento-card p-3 p-md-4" data-reveal="up">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-3">
            <div>
                <div class="hl-eyebrow mb-1">Chi tiết học thuật</div>
                <h2 class="h5 fw-bold mb-0">Hiệu quả theo từng khóa học</h2>
            </div>
            <a asp-area="Instructor" asp-controller="Courses" asp-action="Index"
               class="btn btn-outline-orange d-inline-flex align-items-center"
               style="min-height: 44px;">
                <i class="bi bi-collection-play me-2"></i> Quản lý tất cả khóa học
            </a>
        </div>
        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Khóa học</th>
                        <th class="text-nowrap">Học viên</th>
                        <th class="text-nowrap">Tiến độ TB</th>
                        <th class="text-nowrap">Đánh giá</th>
                        <th class="text-end text-nowrap">Doanh thu ròng</th>
                        <th class="text-end text-nowrap">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.CourseStats.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-bar-chart fs-2 text-huit d-block mb-2"></i>
                                Chưa có dữ liệu khóa học nào.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var c in Model.CourseStats)
                        {
                            <tr>
                                <td class="fw-semibold" style="min-width: 220px;">@c.Title</td>
                                <td class="text-nowrap"><span class="badge badge-huit">@c.EnrollmentCount HV</span></td>
                                <td style="min-width: 150px;">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress progress-orange flex-grow-1" style="height: 7px;">
                                            <div class="progress-bar" style="width: @c.AvgProgressPercent.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                        </div>
                                        <span class="small fw-semibold text-nowrap">@c.AvgProgressPercent.ToString("0.#")%</span>
                                    </div>
                                </td>
                                <td class="small text-nowrap fw-medium">@(c.AvgRating > 0 ? $"{c.AvgRating:0.0} ★" : "-")</td>
                                <td class="text-end fw-bold text-orange text-nowrap">@c.Revenue.ToString("N0") đ</td>
                                <td class="text-end">
                                    <div class="d-flex flex-wrap justify-content-end gap-2">
                                        <a asp-area="Instructor" asp-controller="Courses" asp-action="Curriculum" asp-route-id="@c.CourseId"
                                           class="btn btn-outline-huit d-inline-flex align-items-center justify-content-center"
                                           style="min-height: 44px; min-width: 44px;"
                                           title="Quản lý chương &amp; bài học">
                                            <i class="bi bi-diagram-3"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        new Chart(document.getElementById('instructorChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(labelsJson),
                datasets: [
                    {
                        label: 'Doanh thu ròng (VNĐ)',
                        data: @Html.Raw(revenueJson),
                        backgroundColor: 'rgba(249, 115, 22, 0.85)',
                        hoverBackgroundColor: '#F97316',
                        borderColor: '#F97316',
                        borderWidth: 1,
                        borderRadius: 8,
                        yAxisID: 'y'
                    },
                    {
                        label: 'Học viên mới',
                        data: @Html.Raw(enrollsJson),
                        type: 'line',
                        borderColor: '#1D4ED8',
                        backgroundColor: 'rgba(29, 78, 216, 0.12)',
                        pointBackgroundColor: '#1D4ED8',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        borderWidth: 2.5,
                        fill: true,
                        yAxisID: 'y1',
                        tension: 0.35
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: {
                        position: 'top',
                        labels: { usePointStyle: true, boxWidth: 8 }
                    }
                },
                scales: {
                    y: { beginAtZero: true, position: 'left', grid: { color: 'rgba(148, 163, 184, 0.16)' } },
                    y1: { beginAtZero: true, position: 'right', grid: { drawOnChartArea: false } }
                }
            }
        });
    </script>
}
