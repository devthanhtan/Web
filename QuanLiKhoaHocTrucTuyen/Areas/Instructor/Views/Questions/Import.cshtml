@model QuanLiKhoaHocTrucTuyen.Areas.Instructor.ViewModels.QuestionImportViewModel
@{
    ViewData["Title"] = "Nhập câu hỏi từ Excel/CSV";
    ViewData["AreaTitle"] = "Kênh Giảng viên";
}

<section class="hl-section pt-0">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4" data-reveal="up">
                <div>
                    <div class="hl-eyebrow mb-2">
                        <i class="bi bi-file-earmark-excel me-1"></i> HUIT Learning · Nhập liệu hàng loạt
                    </div>
                    <h1 class="h3 fw-bold mb-1">Nhập hàng loạt câu hỏi (.xlsx / .csv)</h1>
                    <p class="small text-muted mb-0">Khóa học: <strong class="text-huit">@Model.CourseTitle</strong></p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="DownloadTemplate"
                       class="btn btn-outline-orange d-inline-flex align-items-center"
                       style="min-height: 44px;">
                        <i class="bi bi-download me-1"></i> Tải file Excel mẫu (.xlsx)
                    </a>
                </div>
            </div>

            <div class="hl-bento-card p-3 p-md-4" data-reveal="up">
                <div class="alert bg-orange-soft border-0 rounded-3 small mb-4 overflow-x-auto">
                    <strong class="d-block mb-1">Cấu trúc cột chuẩn (hàng 1 là tiêu đề):</strong>
                    <code class="text-nowrap">Topic | Content | OptionA | OptionB | OptionC | OptionD | CorrectOption (A/B/C/D) | Explanation</code>
                </div>

                @if (Model.RowErrors.Any())
                {
                    <div class="alert alert-danger border-0 rounded-3 mb-4">
                        <div class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i> Phát hiện lỗi theo từng dòng:</div>
                        <ul class="small mb-0">
                            @foreach (var err in Model.RowErrors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }

                <form asp-action="Import" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input asp-for="CourseId" type="hidden" />
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Chọn tệp .xlsx hoặc .csv</label>
                        <input asp-for="File" type="file" accept=".xlsx,.csv" class="form-control" />
                        <span asp-validation-for="File" class="text-danger small"></span>
                    </div>
                    <div class="pt-3 border-top d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-orange px-4 d-inline-flex align-items-center" style="min-height: 44px;">
                            <i class="bi bi-upload me-2"></i> Tải lên &amp; Nhập dữ liệu
                        </button>
                        <a asp-action="Index" asp-route-courseId="@Model.CourseId"
                           class="btn btn-light border px-4 d-inline-flex align-items-center"
                           style="min-height: 44px;">
                            Quay lại
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
