@model List<QuanLiKhoaHocTrucTuyen.Models.Question>
@{
    ViewData["Title"] = "Ngân hàng câu hỏi";
    ViewData["AreaTitle"] = "Kênh Giảng viên";
    var selectedCourseId = (int)(ViewBag.SelectedCourseId ?? 0);
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="h3 mb-1">Ngân hàng câu hỏi trắc nghiệm</h1>
        <p class="text-muted small mb-0">Xây dựng câu hỏi thủ công hoặc nhập hàng loạt từ file Excel / CSV</p>
    </div>
    @if (selectedCourseId > 0)
    {
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Import" asp-route-courseId="@selectedCourseId" class="btn btn-outline-orange">
                <i class="bi bi-file-earmark-excel me-1"></i> Nhập Excel / CSV
            </a>
            <a asp-action="Create" asp-route-courseId="@selectedCourseId" class="btn btn-orange">
                <i class="bi bi-plus-lg me-1"></i> Thêm câu hỏi
            </a>
        </div>
    }
</div>

<div class="app-card p-3 p-md-4 mb-4">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-8">
            <label class="form-label small fw-semibold">Chọn khóa học</label>
            <select name="courseId" asp-items="ViewBag.Courses" class="form-select" onchange="this.form.submit()"></select>
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-outline-orange w-100">Xem câu hỏi</button>
        </div>
    </form>
</div>

<div class="app-card p-3 p-md-4">
    @if (!Model.Any())
    {
        <div class="text-center text-muted py-4">Chưa có câu hỏi nào trong khóa học này.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Chủ đề</th>
                        <th>Câu hỏi &amp; Đáp án</th>
                        <th>Đúng</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in Model)
                    {
                        <tr>
                            <td><span class="badge badge-orange">@(q.Topic ?? "Chung")</span></td>
                            <td>
                                <div class="fw-semibold mb-1">@q.Content</div>
                                <div class="small text-muted">
                                    A: @q.OptionA · B: @q.OptionB · C: @q.OptionC · D: @q.OptionD
                                </div>
                            </td>
                            <td><span class="badge bg-success fs-6">@q.CorrectOption</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@q.Id" class="btn btn-sm btn-outline-orange"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Xóa câu hỏi này?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@q.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
