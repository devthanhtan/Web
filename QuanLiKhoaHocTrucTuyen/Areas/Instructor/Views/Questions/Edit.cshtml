@model QuanLiKhoaHocTrucTuyen.Areas.Instructor.ViewModels.QuestionFormViewModel
@{
    ViewData["Title"] = "Chỉnh sửa câu hỏi";
    ViewData["AreaTitle"] = "Kênh Giảng viên";
}

<section class="hl-section pt-0">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4" data-reveal="up">
                <div>
                    <div class="hl-eyebrow mb-2">
                        <i class="bi bi-pencil-square me-1"></i> HUIT Learning · Ngân hàng Câu hỏi
                    </div>
                    <h1 class="h3 fw-bold mb-1">Chỉnh sửa câu hỏi</h1>
                    <p class="small text-muted mb-0">Khóa học: <strong class="text-huit">@ViewBag.CourseTitle</strong></p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Index" asp-route-courseId="@Model.CourseId"
                       class="btn btn-outline-huit d-inline-flex align-items-center"
                       style="min-height: 44px;">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </div>

            <div class="hl-bento-card p-3 p-md-4" data-reveal="up">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />
                    <input asp-for="CourseId" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Topic" class="form-label fw-semibold"></label>
                        <input asp-for="Topic" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Content" class="form-label fw-semibold"></label>
                        <textarea asp-for="Content" rows="3" class="form-control"></textarea>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="OptionA" class="form-label fw-semibold"></label>
                            <input asp-for="OptionA" class="form-control" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="OptionB" class="form-label fw-semibold"></label>
                            <input asp-for="OptionB" class="form-control" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="OptionC" class="form-label fw-semibold"></label>
                            <input asp-for="OptionC" class="form-control" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="OptionD" class="form-label fw-semibold"></label>
                            <input asp-for="OptionD" class="form-control" />
                        </div>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-4">
                            <label asp-for="CorrectOption" class="form-label fw-semibold"></label>
                            <select asp-for="CorrectOption" class="form-select">
                                <option value="A">A</option>
                                <option value="B">B</option>
                                <option value="C">C</option>
                                <option value="D">D</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-8">
                            <label asp-for="Explanation" class="form-label fw-semibold"></label>
                            <input asp-for="Explanation" class="form-control" />
                        </div>
                    </div>
                    <div class="pt-3 border-top d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-orange px-4 d-inline-flex align-items-center" style="min-height: 44px;">
                            <i class="bi bi-save me-2"></i> Lưu thay đổi
                        </button>
                        <a asp-action="Index" asp-route-courseId="@Model.CourseId"
                           class="btn btn-light border px-4 d-inline-flex align-items-center"
                           style="min-height: 44px;">
                            Quay lại
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
