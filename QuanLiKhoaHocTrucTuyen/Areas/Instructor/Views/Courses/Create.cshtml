@model QuanLiKhoaHocTrucTuyen.Areas.Instructor.ViewModels.CourseFormViewModel
@{
    ViewData["Title"] = "Tạo khóa học mới";
    ViewData["AreaTitle"] = "Kênh Giảng viên";
}

<section class="hl-section pt-0">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-9">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4" data-reveal="up">
                <div>
                    <div class="hl-eyebrow mb-2">
                        <i class="bi bi-plus-circle me-1"></i> HUIT Learning · Khởi tạo khóa học
                    </div>
                    <h1 class="h3 fw-bold mb-1">Tạo khóa học mới</h1>
                    <p class="text-muted small mb-0">Khóa học mới tạo sẽ ở trạng thái Nháp (chỉ bạn nhìn thấy cho đến khi gửi duyệt)</p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Index" class="btn btn-outline-huit d-inline-flex align-items-center" style="min-height: 44px;">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                    </a>
                </div>
            </div>

            <div class="hl-bento-card p-3 p-md-4" data-reveal="up">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-3 g-md-4">
                        <div class="col-12">
                            <label asp-for="Title" class="form-label fw-semibold"></label>
                            <input asp-for="Title" class="form-control" placeholder="Ví dụ: Lập trình Web ASP.NET Core 8 Toàn Tập" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="CategoryId" class="form-label fw-semibold"></label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"></select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="Level" class="form-label fw-semibold"></label>
                            <select asp-for="Level" class="form-select">
                                <option value="Cơ bản">Cơ bản</option>
                                <option value="Trung cấp">Trung cấp</option>
                                <option value="Nâng cao">Nâng cao</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="Price" class="form-label fw-semibold"></label>
                            <input asp-for="Price" type="number" step="1000" min="0" class="form-control" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="ShortDescription" class="form-label fw-semibold"></label>
                            <input asp-for="ShortDescription" class="form-control" placeholder="Tóm tắt ngắn gọn giá trị khóa học trong 1-2 câu" />
                            <span asp-validation-for="ShortDescription" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" rows="5" class="form-control" placeholder="Mô tả chi tiết nội dung, đối tượng học viên và kết quả đầu ra..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="ThumbnailFile" class="form-label fw-semibold"></label>
                            <input asp-for="ThumbnailFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" id="createThumbInput" />
                            <span asp-validation-for="ThumbnailFile" class="text-danger small"></span>
                            <div class="mt-3">
                                <div class="ratio ratio-16x9 rounded-3 overflow-hidden border bg-light" style="max-width: 240px;">
                                    <img id="createThumbPreview"
                                         src="/images/course-default.svg"
                                         onerror="this.onerror=null;this.src='/images/course-default.svg';"
                                         alt="Xem trước ảnh bìa"
                                         class="w-100 h-100"
                                         style="object-fit: cover;" />
                                </div>
                                <div class="form-text">Xem trước ảnh bìa (tỷ lệ chuẩn 16:9)</div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="IntroYoutubeId" class="form-label fw-semibold"></label>
                            <input asp-for="IntroYoutubeId" class="form-control" placeholder="Ví dụ: BfEjDD8mWYg" />
                            <div class="form-text">Nhập mã ID video YouTube giới thiệu khóa học (tùy chọn).</div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-orange px-4 d-inline-flex align-items-center" style="min-height: 44px;">
                            <i class="bi bi-save me-2"></i> Lưu &amp; Soạn bài học
                        </button>
                        <a asp-action="Index" class="btn btn-light border px-4 d-inline-flex align-items-center" style="min-height: 44px;">
                            Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('createThumbInput')?.addEventListener('change', function (e) {
            const file = e.target.files && e.target.files[0];
            if (!file) return;
            const preview = document.getElementById('createThumbPreview');
            if (preview) preview.src = URL.createObjectURL(file);
        });
    </script>
}
