@model List<QuanLiKhoaHocTrucTuyen.Models.Course>
@{
    ViewData["Title"] = "Khóa học của tôi (Giảng viên)";
    ViewData["AreaTitle"] = "Kênh Giảng viên";
    var approvedCount = Model.Count(c => c.Status == CourseStatus.Approved);
    var pendingCount = Model.Count(c => c.Status == CourseStatus.PendingReview);
    var totalEnrollments = Model.Sum(c => c.Enrollments.Count);
}

<section class="hl-section pt-0">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4" data-reveal="up">
        <div>
            <div class="hl-eyebrow mb-2">
                <i class="bi bi-mortarboard me-1"></i> HUIT Learning · Studio Giảng viên
            </div>
            <h1 class="h3 fw-bold mb-1">Quản lý khóa học</h1>
            <p class="text-muted small mb-0">Tạo mới, biên soạn chương bài học, tải video và gửi duyệt xuất bản công khai</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Create" class="btn btn-orange d-inline-flex align-items-center px-3" style="min-height: 44px;">
                <i class="bi bi-plus-lg me-1"></i> Tạo khóa học mới
            </a>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4" data-stagger-group>
        <div class="col" data-reveal="up">
            <div class="hl-bento-card stat-card h-100 p-3 p-md-4">
                <div class="d-flex justify-content-between align-items-center gap-2">
                    <div>
                        <div class="small text-muted fw-medium">Tổng khóa học</div>
                        <div class="fs-3 fw-bold text-huit mt-1" data-count-to="@Model.Count">@Model.Count</div>
                    </div>
                    <div class="stat-icon flex-shrink-0"><i class="bi bi-collection-play"></i></div>
                </div>
            </div>
        </div>
        <div class="col" data-reveal="up">
            <div class="hl-bento-card stat-card h-100 p-3 p-md-4">
                <div class="d-flex justify-content-between align-items-center gap-2">
                    <div>
                        <div class="small text-muted fw-medium">Đã duyệt công khai</div>
                        <div class="fs-3 fw-bold text-success mt-1" data-count-to="@approvedCount">@approvedCount</div>
                    </div>
                    <div class="stat-icon flex-shrink-0"><i class="bi bi-check2-circle"></i></div>
                </div>
            </div>
        </div>
        <div class="col" data-reveal="up">
            <div class="hl-bento-card stat-card h-100 p-3 p-md-4">
                <div class="d-flex justify-content-between align-items-center gap-2">
                    <div>
                        <div class="small text-muted fw-medium">Chờ kiểm duyệt</div>
                        <div class="fs-3 fw-bold text-warning-emphasis mt-1" data-count-to="@pendingCount">@pendingCount</div>
                    </div>
                    <div class="stat-icon flex-shrink-0"><i class="bi bi-hourglass-split"></i></div>
                </div>
            </div>
        </div>
        <div class="col" data-reveal="up">
            <div class="hl-bento-card stat-card h-100 p-3 p-md-4">
                <div class="d-flex justify-content-between align-items-center gap-2">
                    <div>
                        <div class="small text-muted fw-medium">Tổng lượt ghi danh</div>
                        <div class="fs-3 fw-bold text-orange mt-1" data-count-to="@totalEnrollments">@totalEnrollments</div>
                    </div>
                    <div class="stat-icon flex-shrink-0"><i class="bi bi-people"></i></div>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="hl-bento-card p-4 p-md-5 text-center" data-reveal="up">
            <div class="stat-icon mx-auto mb-3"><i class="bi bi-collection-play"></i></div>
            <h2 class="h5 fw-bold mb-2">Bạn chưa tạo khóa học nào</h2>
            <p class="text-muted small mb-4 mx-auto" style="max-width: 480px;">
                Tạo khóa học đầu tiên trên HUIT Learning để bắt đầu chia sẻ kiến thức và xây dựng thương hiệu giảng dạy.
            </p>
            <a asp-action="Create" class="btn btn-orange px-4 d-inline-flex align-items-center" style="min-height: 44px;">
                <i class="bi bi-plus-lg me-1"></i> Tạo khóa học ngay
            </a>
        </div>
    }
    else
    {
        <div class="hl-bento-card p-3 p-md-4" data-reveal="up">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
                <div>
                    <div class="hl-eyebrow mb-1">Danh mục giảng dạy</div>
                    <h2 class="h5 fw-bold mb-0">Danh sách khóa học (@Model.Count)</h2>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Khóa học</th>
                            <th class="text-nowrap">Danh mục</th>
                            <th class="text-nowrap">Học phí</th>
                            <th class="text-nowrap">Nội dung</th>
                            <th class="text-nowrap">Trạng thái</th>
                            <th class="text-end text-nowrap">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            var totalLessons = c.Chapters.Sum(ch => ch.Lessons.Count);
                            var thumbUrl = string.IsNullOrEmpty(c.ThumbnailUrl) ? "/images/course-default.svg" : c.ThumbnailUrl;
                            <tr>
                                <td style="min-width: 260px;">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@thumbUrl"
                                             onerror="this.onerror=null;this.src='/images/course-default.svg';"
                                             alt="@c.Title"
                                             class="course-thumb rounded-3 border flex-shrink-0"
                                             style="width: 96px; aspect-ratio: 16 / 9; object-fit: cover;" />
                                        <div class="min-w-0">
                                            <div class="fw-bold text-dark">@c.Title</div>
                                            <div class="small text-muted">@c.Level · @c.Enrollments.Count học viên</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-nowrap"><span class="badge badge-huit">@c.Category.Name</span></td>
                                <td class="fw-semibold text-orange text-nowrap">@c.Price.ToString("N0") đ</td>
                                <td class="small text-nowrap">@c.Chapters.Count chương · @totalLessons bài</td>
                                <td>
                                    @switch (c.Status)
                                    {
                                        case CourseStatus.Draft:
                                            <span class="badge bg-secondary text-nowrap">Nháp</span>
                                            break;
                                        case CourseStatus.PendingReview:
                                            <span class="badge bg-warning-subtle text-warning-emphasis text-nowrap">Chờ Admin duyệt</span>
                                            break;
                                        case CourseStatus.Approved:
                                            <span class="badge bg-success text-nowrap">Đã duyệt công khai</span>
                                            break;
                                        case CourseStatus.Rejected:
                                            <span class="badge bg-danger text-nowrap">Bị từ chối</span>
                                            if (!string.IsNullOrEmpty(c.RejectionReason))
                                            {
                                                <div class="small text-danger mt-1" style="max-width: 220px;">@c.RejectionReason</div>
                                            }
                                            break;
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex flex-wrap gap-2 justify-content-end">
                                        <a asp-action="Curriculum" asp-route-id="@c.Id"
                                           class="btn btn-sm btn-orange d-inline-flex align-items-center"
                                           style="min-height: 44px;">
                                            <i class="bi bi-diagram-3 me-1"></i> Chương &amp; Bài
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@c.Id"
                                           class="btn btn-sm btn-outline-orange d-inline-flex align-items-center"
                                           style="min-height: 44px;">
                                            <i class="bi bi-pencil me-1"></i> Sửa
                                        </a>
                                        <a asp-area="Instructor" asp-controller="Questions" asp-action="Index" asp-route-courseId="@c.Id"
                                           class="btn btn-sm btn-outline-huit d-inline-flex align-items-center justify-content-center"
                                           style="min-height: 44px; min-width: 44px;"
                                           title="Ngân hàng câu hỏi">
                                            <i class="bi bi-patch-question"></i>
                                        </a>
                                        <a asp-area="Instructor" asp-controller="Quizzes" asp-action="Index" asp-route-courseId="@c.Id"
                                           class="btn btn-sm btn-outline-huit d-inline-flex align-items-center justify-content-center"
                                           style="min-height: 44px; min-width: 44px;"
                                           title="Bài kiểm tra &amp; Thi">
                                            <i class="bi bi-ui-checks-grid"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>
