@model List<QuanLiKhoaHocTrucTuyen.Models.Quiz>
@{
    ViewData["Title"] = "Quản lý bài kiểm tra & thi";
    ViewData["AreaTitle"] = "Kênh Giảng viên";
    var selectedCourseId = (int)(ViewBag.SelectedCourseId ?? 0);
}

<section class="hl-section pt-0">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4" data-reveal="up">
        <div>
            <div class="hl-eyebrow mb-2">
                <i class="bi bi-ui-checks-grid me-1"></i> HUIT Learning · Khảo thí &amp; Chứng nhận
            </div>
            <h1 class="h3 fw-bold mb-1">Bài kiểm tra &amp; Bài thi cuối khóa</h1>
            <p class="text-muted small mb-0">Thiết lập thời gian làm bài, điểm chuẩn đạt và số lần thi lại tối đa</p>
        </div>
        @if (selectedCourseId > 0)
        {
            <div class="d-flex flex-wrap gap-2">
                <a asp-area="Instructor" asp-controller="Questions" asp-action="Index" asp-route-courseId="@selectedCourseId"
                   class="btn btn-outline-huit d-inline-flex align-items-center"
                   style="min-height: 44px;">
                    <i class="bi bi-patch-question me-1"></i> Ngân hàng câu hỏi
                </a>
                <a asp-action="Create" asp-route-courseId="@selectedCourseId"
                   class="btn btn-orange d-inline-flex align-items-center px-3"
                   style="min-height: 44px;">
                    <i class="bi bi-plus-lg me-1"></i> Tạo bài kiểm tra
                </a>
            </div>
        }
    </div>

    <div class="hl-bento-card p-3 p-md-4 mb-4" data-reveal="up">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-12 col-md-8 col-lg-9">
                <label class="form-label small fw-semibold">Chọn khóa học</label>
                <select name="courseId" asp-items="ViewBag.Courses" class="form-select" style="min-height: 44px;" onchange="this.form.submit()"></select>
            </div>
            <div class="col-12 col-md-4 col-lg-3 d-grid">
                <button type="submit" class="btn btn-outline-orange" style="min-height: 44px;">
                    <i class="bi bi-funnel me-1"></i> Xem bài kiểm tra
                </button>
            </div>
        </form>
    </div>

    <div class="hl-bento-card p-3 p-md-4" data-reveal="up">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-ui-checks-grid fs-1 text-orange d-block mb-2"></i>
                <div class="fw-semibold text-dark mb-1">Chưa có bài kiểm tra nào</div>
                <div class="small">Hãy tạo bài kiểm tra chương hoặc bài thi cuối khóa cho khóa học này.</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tiêu đề</th>
                            <th>Loại</th>
                            <th class="text-nowrap">Thời gian</th>
                            <th class="text-nowrap">Điểm đạt</th>
                            <th class="text-nowrap">Thi lại</th>
                            <th class="text-nowrap">Số câu</th>
                            <th class="text-end text-nowrap">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var q in Model)
                        {
                            <tr>
                                <td class="fw-semibold" style="min-width: 220px;">@q.Title</td>
                                <td>
                                    @if (q.IsFinalExam)
                                    {
                                        <span class="badge bg-danger-subtle text-danger text-nowrap">Thi cuối khóa (Cấp chứng chỉ)</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-orange">Theo chương: @(q.Chapter?.Title ?? "-")</span>
                                    }
                                </td>
                                <td class="text-nowrap">@q.DurationMinutes phút</td>
                                <td class="text-nowrap fw-semibold text-huit">@q.PassingScorePercent%</td>
                                <td class="text-nowrap">@(q.MaxAttempts == 0 ? "Không giới hạn" : $"{q.MaxAttempts} lần")</td>
                                <td class="text-nowrap"><span class="badge badge-huit">@q.QuizQuestions.Count câu</span></td>
                                <td class="text-end">
                                    <div class="d-flex flex-wrap gap-2 justify-content-end">
                                        <a asp-action="Edit" asp-route-id="@q.Id"
                                           class="btn btn-sm btn-outline-orange d-inline-flex align-items-center justify-content-center"
                                           style="min-height: 44px; min-width: 44px;"
                                           title="Chỉnh sửa bài kiểm tra">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Xóa bài kiểm tra này?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@q.Id" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger d-inline-flex align-items-center justify-content-center"
                                                    style="min-height: 44px; min-width: 44px;"
                                                    title="Xóa bài kiểm tra">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
