@model QuanLiKhoaHocTrucTuyen.Areas.Admin.ViewModels.UsersIndexViewModel
@{
    ViewData["Title"] = "Quản lý người dùng";
    ViewData["AreaTitle"] = "Quản trị Admin";
    var totalUsers = Model.Users.Count;
    var activeUsers = Model.Users.Count(u => !u.IsLocked);
    var confirmedUsers = Model.Users.Count(u => u.EmailConfirmed);
    var lockedUsers = Model.Users.Count(u => u.IsLocked);
}

<section class="hl-section">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4" data-reveal="up">
        <div>
            <div class="hl-eyebrow mb-1">HUIT Learning · Định danh &amp; Phân quyền</div>
            <h1 class="h3 fw-bold mb-1">Quản lý tài khoản người dùng</h1>
            <p class="text-muted small mb-0">Tìm kiếm theo tên/email, lọc theo vai trò và khóa hoặc mở khóa tài khoản</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <span class="badge badge-huit d-inline-flex align-items-center px-3 py-2">
                <i class="bi bi-people me-2"></i> Kết quả: @totalUsers tài khoản
            </span>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4" data-stagger-group>
        <div class="col" data-reveal="up">
            <div class="hl-bento-card stat-card h-100 p-3 p-md-4" data-tilt-3d>
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div class="small text-muted fw-semibold">Tổng tài khoản</div>
                        <div class="fs-3 fw-bold text-dark mt-1" data-count-to="@totalUsers">@totalUsers</div>
                    </div>
                    <div class="stat-icon flex-shrink-0"><i class="bi bi-people-fill"></i></div>
                </div>
            </div>
        </div>
        <div class="col" data-reveal="up" data-reveal-delay="80">
            <div class="hl-bento-card stat-card h-100 p-3 p-md-4" data-tilt-3d>
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div class="small text-muted fw-semibold">Đang hoạt động</div>
                        <div class="fs-3 fw-bold text-success mt-1" data-count-to="@activeUsers">@activeUsers</div>
                    </div>
                    <div class="stat-icon flex-shrink-0"><i class="bi bi-person-check-fill"></i></div>
                </div>
            </div>
        </div>
        <div class="col" data-reveal="up" data-reveal-delay="160">
            <div class="hl-bento-card stat-card h-100 p-3 p-md-4" data-tilt-3d>
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div class="small text-muted fw-semibold">Email đã xác thực</div>
                        <div class="fs-3 fw-bold text-huit mt-1" data-count-to="@confirmedUsers">@confirmedUsers</div>
                    </div>
                    <div class="stat-icon flex-shrink-0"><i class="bi bi-envelope-check-fill"></i></div>
                </div>
            </div>
        </div>
        <div class="col" data-reveal="up" data-reveal-delay="240">
            <div class="hl-bento-card stat-card h-100 p-3 p-md-4" data-tilt-3d>
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div class="small text-muted fw-semibold">Đang bị khóa</div>
                        <div class="fs-3 fw-bold text-danger mt-1" data-count-to="@lockedUsers">@lockedUsers</div>
                    </div>
                    <div class="stat-icon flex-shrink-0"><i class="bi bi-shield-lock-fill"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="hl-bento-card p-3 p-md-4" data-reveal="up">
        <div class="mb-4">
            <div class="hl-eyebrow mb-2">Tra cứu &amp; Lọc vai trò</div>
            <form method="get" class="row g-3 align-items-stretch">
                <div class="col-12 col-md-5">
                    <input type="text" name="keyword" value="@Model.Keyword"
                           class="form-control h-100"
                           style="min-height: 44px;"
                           placeholder="Tìm theo họ tên hoặc email..." />
                </div>
                <div class="col-12 col-md-4">
                    <select name="role" class="form-select h-100" style="min-height: 44px;">
                        <option value="">-- Tất cả vai trò --</option>
                        @foreach (var r in AppRoles.All)
                        {
                            <option value="@r" selected="@(Model.Role == r)">@r</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-3 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-orange flex-grow-1 d-inline-flex align-items-center justify-content-center" style="min-height: 44px;">
                        <i class="bi bi-search me-2"></i> Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-outline-huit d-inline-flex align-items-center justify-content-center px-3" style="min-height: 44px;">
                        Đặt lại
                    </a>
                </div>
            </form>
        </div>

        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-nowrap">Họ và tên</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th class="text-nowrap">Xác thực</th>
                        <th class="text-nowrap">Trạng thái</th>
                        <th class="text-end text-nowrap">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Users.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-person-x fs-3 d-block mb-2 opacity-50"></i>
                                Không tìm thấy người dùng nào.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var u in Model.Users)
                        {
                            <tr>
                                <td class="fw-semibold text-dark text-nowrap">@u.FullName</td>
                                <td class="small text-muted">@u.Email</td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var r in u.Roles)
                                        {
                                            <span class="badge @(r == AppRoles.Admin ? "badge-huit" : "badge-orange")">@r</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-nowrap">
                                    @if (u.EmailConfirmed)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Đã xác thực</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Chờ xác thực</span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    @if (u.IsLocked)
                                    {
                                        <span class="badge bg-danger">Đang bị khóa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <div class="d-flex flex-wrap gap-2 justify-content-end">
                                        <form asp-action="ToggleLock" method="post" class="d-inline m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <input type="hidden" name="keyword" value="@Model.Keyword" />
                                            <input type="hidden" name="role" value="@Model.Role" />
                                            <button type="submit"
                                                    class="btn @(u.IsLocked ? "btn-outline-success" : "btn-outline-danger") d-inline-flex align-items-center px-3"
                                                    style="min-height: 44px;">
                                                <i class="bi @(u.IsLocked ? "bi-unlock" : "bi-lock") me-2"></i>
                                                @(u.IsLocked ? "Mở khóa" : "Khóa")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
