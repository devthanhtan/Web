@model QuanLiKhoaHocTrucTuyen.Areas.Admin.ViewModels.UsersIndexViewModel
@{
    ViewData["Title"] = "Quản lý người dùng";
    ViewData["AreaTitle"] = "Quản trị Admin";
}

<div class="app-card p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h1 class="h4 mb-1">Quản lý tài khoản người dùng</h1>
            <p class="text-muted small mb-0">Tìm kiếm theo tên/email, lọc theo vai trò và khóa hoặc mở khóa tài khoản</p>
        </div>
    </div>

    <form method="get" class="row g-2 mb-4">
        <div class="col-md-5">
            <input type="text" name="keyword" value="@Model.Keyword" class="form-control" placeholder="Tìm theo họ tên hoặc email..." />
        </div>
        <div class="col-md-4">
            <select name="role" class="form-select">
                <option value="">-- Tất cả vai trò --</option>
                @foreach (var r in AppRoles.All)
                {
                    <option value="@r" selected="@(Model.Role == r)">@r</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-orange flex-grow-1"><i class="bi bi-search me-1"></i> Lọc</button>
            <a asp-action="Index" class="btn btn-light border">Đặt lại</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table align-middle table-hover">
            <thead class="table-light">
                <tr>
                    <th>Họ và tên</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th>Xác thực</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Users.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Không tìm thấy người dùng nào.</td></tr>
                }
                else
                {
                    @foreach (var u in Model.Users)
                    {
                        <tr>
                            <td class="fw-semibold">@u.FullName</td>
                            <td>@u.Email</td>
                            <td>
                                @foreach (var r in u.Roles)
                                {
                                    <span class="badge badge-orange me-1">@r</span>
                                }
                            </td>
                            <td>
                                @if (u.EmailConfirmed)
                                {
                                    <span class="badge bg-success-subtle text-success">Đã xác thực</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis">Chờ xác thực</span>
                                }
                            </td>
                            <td>
                                @if (u.IsLocked)
                                {
                                    <span class="badge bg-danger">Đang bị khóa</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Hoạt động</span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-action="ToggleLock" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <input type="hidden" name="keyword" value="@Model.Keyword" />
                                    <input type="hidden" name="role" value="@Model.Role" />
                                    <button type="submit" class="btn btn-sm @(u.IsLocked ? "btn-outline-success" : "btn-outline-danger")">
                                        <i class="bi @(u.IsLocked ? "bi-unlock" : "bi-lock") me-1"></i>
                                        @(u.IsLocked ? "Mở khóa" : "Khóa")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
