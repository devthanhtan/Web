@model QuanLiKhoaHocTrucTuyen.Areas.Admin.ViewModels.InstructorRequestsIndexViewModel
@{
    ViewData["Title"] = "Thẩm định hồ sơ Giảng viên";
    ViewData["AreaTitle"] = "Quản trị Admin";
    var totalRequests = Model.Requests.Count;
    var pendingRequests = Model.Requests.Count(r => r.Status == InstructorRequestStatus.Pending);
    var approvedRequests = Model.Requests.Count(r => r.Status == InstructorRequestStatus.Approved);
    var rejectedRequests = Model.Requests.Count(r => r.Status == InstructorRequestStatus.Rejected);
}

<section class="hl-section">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4" data-reveal="up">
        <div>
            <div class="hl-eyebrow mb-1">HUIT Learning · Nhân sự Giảng dạy</div>
            <h1 class="h3 fw-bold mb-1">Thẩm định yêu cầu nâng cấp Giảng viên</h1>
            <p class="text-muted small mb-0">Xem hồ sơ năng lực, phê duyệt cấp quyền Giảng viên hoặc từ chối kèm lý do</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <span class="badge badge-huit d-inline-flex align-items-center px-3 py-2">
                <i class="bi bi-person-badge me-2"></i> Đang hiển thị: @totalRequests hồ sơ
            </span>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4" data-stagger-group>
        <div class="col" data-reveal="up">
            <div class="hl-bento-card stat-card h-100 p-3 p-md-4" data-tilt-3d>
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div class="small text-muted fw-semibold">Tổng hồ sơ</div>
                        <div class="fs-3 fw-bold text-dark mt-1" data-count-to="@totalRequests">@totalRequests</div>
                    </div>
                    <div class="stat-icon flex-shrink-0"><i class="bi bi-folder-check"></i></div>
                </div>
            </div>
        </div>
        <div class="col" data-reveal="up" data-reveal-delay="80">
            <div class="hl-bento-card stat-card h-100 p-3 p-md-4" data-tilt-3d>
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div class="small text-muted fw-semibold">Chờ thẩm định</div>
                        <div class="fs-3 fw-bold text-orange mt-1" data-count-to="@pendingRequests">@pendingRequests</div>
                    </div>
                    <div class="stat-icon flex-shrink-0"><i class="bi bi-clock-history"></i></div>
                </div>
            </div>
        </div>
        <div class="col" data-reveal="up" data-reveal-delay="160">
            <div class="hl-bento-card stat-card h-100 p-3 p-md-4" data-tilt-3d>
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div class="small text-muted fw-semibold">Đã phê duyệt</div>
                        <div class="fs-3 fw-bold text-success mt-1" data-count-to="@approvedRequests">@approvedRequests</div>
                    </div>
                    <div class="stat-icon flex-shrink-0"><i class="bi bi-award-fill"></i></div>
                </div>
            </div>
        </div>
        <div class="col" data-reveal="up" data-reveal-delay="240">
            <div class="hl-bento-card stat-card h-100 p-3 p-md-4" data-tilt-3d>
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div class="small text-muted fw-semibold">Đã từ chối</div>
                        <div class="fs-3 fw-bold text-danger mt-1" data-count-to="@rejectedRequests">@rejectedRequests</div>
                    </div>
                    <div class="stat-icon flex-shrink-0"><i class="bi bi-x-octagon-fill"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="hl-bento-card p-3 p-md-4" data-reveal="up">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
            <div>
                <div class="hl-eyebrow">Bộ lọc hồ sơ</div>
                <h2 class="h6 fw-bold mb-0">Danh sách ứng viên đăng ký Giảng viên</h2>
            </div>
            <div class="hl-pill-scroll d-flex flex-nowrap gap-2 pb-1">
                <a asp-action="Index"
                   class="btn @(Model.StatusFilter == null ? "btn-orange" : "btn-outline-secondary") rounded-pill d-inline-flex align-items-center px-3 text-nowrap"
                   style="min-height: 44px;">Tất cả</a>
                <a asp-action="Index" asp-route-status="@InstructorRequestStatus.Pending"
                   class="btn @(Model.StatusFilter == InstructorRequestStatus.Pending ? "btn-orange" : "btn-outline-secondary") rounded-pill d-inline-flex align-items-center px-3 text-nowrap"
                   style="min-height: 44px;">Chờ duyệt</a>
                <a asp-action="Index" asp-route-status="@InstructorRequestStatus.Approved"
                   class="btn @(Model.StatusFilter == InstructorRequestStatus.Approved ? "btn-orange" : "btn-outline-secondary") rounded-pill d-inline-flex align-items-center px-3 text-nowrap"
                   style="min-height: 44px;">Đã duyệt</a>
                <a asp-action="Index" asp-route-status="@InstructorRequestStatus.Rejected"
                   class="btn @(Model.StatusFilter == InstructorRequestStatus.Rejected ? "btn-orange" : "btn-outline-secondary") rounded-pill d-inline-flex align-items-center px-3 text-nowrap"
                   style="min-height: 44px;">Từ chối</a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ứng viên</th>
                        <th>Chuyên môn &amp; Kinh nghiệm</th>
                        <th class="text-nowrap">Tài liệu</th>
                        <th class="text-nowrap">Trạng thái</th>
                        <th class="text-end text-nowrap">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Requests.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-3 d-block mb-2 opacity-50"></i>
                                Không có yêu cầu nào.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var req in Model.Requests)
                        {
                            <tr>
                                <td style="min-width: 210px;">
                                    <div class="fw-semibold text-dark">@req.User.FullName</div>
                                    <div class="small text-muted">@req.User.Email</div>
                                    <div class="small text-muted text-nowrap mt-1">
                                        <i class="bi bi-clock me-1"></i>@req.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </td>
                                <td style="min-width: 260px;">
                                    <div class="fw-semibold text-dark">
                                        @req.Expertise
                                        <span class="badge badge-huit ms-1">@req.ExperienceYears năm</span>
                                    </div>
                                    <div class="small text-muted mt-1">@req.Bio</div>
                                    @if (!string.IsNullOrEmpty(req.RejectionReason))
                                    {
                                        <div class="small text-danger mt-2 p-2 bg-danger-subtle rounded-2">
                                            <strong>Lý do từ chối:</strong> @req.RejectionReason
                                        </div>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    <div class="d-flex flex-wrap gap-2">
                                        <a href="@req.CvFilePath" target="_blank"
                                           class="btn btn-outline-huit d-inline-flex align-items-center px-3"
                                           style="min-height: 44px;">
                                            <i class="bi bi-file-earmark-text me-2"></i> Xem CV
                                        </a>
                                        @if (!string.IsNullOrEmpty(req.CertificateFilePath))
                                        {
                                            <a href="@req.CertificateFilePath" target="_blank"
                                               class="btn btn-outline-orange d-inline-flex align-items-center px-3"
                                               style="min-height: 44px;">
                                                <i class="bi bi-award me-2"></i> Chứng chỉ
                                            </a>
                                        }
                                    </div>
                                </td>
                                <td class="text-nowrap">
                                    @switch (req.Status)
                                    {
                                        case InstructorRequestStatus.Pending:
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Chờ duyệt</span>
                                            break;
                                        case InstructorRequestStatus.Approved:
                                            <span class="badge bg-success">Đã duyệt</span>
                                            break;
                                        case InstructorRequestStatus.Rejected:
                                            <span class="badge bg-danger">Từ chối</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    @if (req.Status == InstructorRequestStatus.Pending)
                                    {
                                        <div class="d-flex flex-wrap gap-2 justify-content-end">
                                            <form asp-action="Approve" method="post" class="d-inline m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@req.Id" />
                                                <button type="submit"
                                                        class="btn btn-success d-inline-flex align-items-center px-3"
                                                        style="min-height: 44px;">
                                                    <i class="bi bi-check2-circle me-2"></i> Phê duyệt
                                                </button>
                                            </form>
                                            <button type="button"
                                                    class="btn btn-outline-danger d-inline-flex align-items-center px-3"
                                                    style="min-height: 44px;"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#rejectModal"
                                                    data-request-id="@req.Id"
                                                    data-applicant="@req.User.FullName">
                                                <i class="bi bi-x-circle me-2"></i> Từ chối
                                            </button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <form asp-action="Reject" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="RequestId" id="rejectRequestId" />
                <div class="modal-header bg-light border-bottom">
                    <div>
                        <div class="hl-eyebrow">Thẩm định nhân sự</div>
                        <h5 class="modal-title fw-bold mb-0">Từ chối hồ sơ Giảng viên</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="small text-muted mb-3">Ứng viên: <strong id="rejectApplicantName" class="text-dark"></strong></p>
                    <label class="form-label fw-semibold">Lý do từ chối (bắt buộc)</label>
                    <textarea name="RejectionReason" class="form-control" rows="3" required placeholder="Nhập lý do chi tiết để ứng viên bổ sung hồ sơ..."></textarea>
                </div>
                <div class="modal-footer bg-light border-top d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-light border px-3" style="min-height: 44px;" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger px-3" style="min-height: 44px;">Xác nhận từ chối</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('rejectModal')?.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            document.getElementById('rejectRequestId').value = btn.getAttribute('data-request-id');
            document.getElementById('rejectApplicantName').textContent = btn.getAttribute('data-applicant');
        });
    </script>
}
