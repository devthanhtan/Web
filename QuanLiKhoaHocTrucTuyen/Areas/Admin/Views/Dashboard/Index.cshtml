@model QuanLiKhoaHocTrucTuyen.Services.Interfaces.AdminReportDto
@using System.Text.Json
@{
    ViewData["Title"] = "Tổng quan & Báo cáo Admin";
    ViewData["AreaTitle"] = "Quản trị Admin";
    var labelsJson = JsonSerializer.Serialize(Model.Buckets.Select(b => b.Label));
    var grossJson = JsonSerializer.Serialize(Model.Buckets.Select(b => b.GrossRevenue));
    var platformJson = JsonSerializer.Serialize(Model.Buckets.Select(b => b.PlatformAmount));
    var instructorJson = JsonSerializer.Serialize(Model.Buckets.Select(b => b.InstructorAmount));
    var usersJson = JsonSerializer.Serialize(Model.Buckets.Select(b => b.NewUsers));
    var enrollsJson = JsonSerializer.Serialize(Model.Buckets.Select(b => b.NewEnrollments));
    var platformSharePct = Model.TotalGrossRevenue > 0
        ? Math.Round((Model.TotalPlatformCommission / Model.TotalGrossRevenue) * 100m, 1)
        : Model.CurrentCommissionRate;
    var instructorSharePct = Math.Max(0m, 100m - platformSharePct);
}

<section class="hl-section">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4" data-reveal="up">
        <div>
            <div class="hl-eyebrow mb-1">HUIT Learning · Trung tâm Điều hành</div>
            <h1 class="h3 fw-bold mb-1 text-gradient-huit">Báo cáo tổng thể hệ thống</h1>
            <p class="text-muted small mb-0">Doanh thu toàn sàn, phân chia hoa hồng, biến động tài khoản và khóa học tương tác cao</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <div class="btn-group" role="group" aria-label="Chọn chu kỳ báo cáo">
                <a asp-action="Index" asp-route-period="week"
                   class="btn @(Model.Period == "week" ? "btn-huit" : "btn-outline-huit") d-inline-flex align-items-center px-3"
                   style="min-height: 44px;">
                    <i class="bi bi-calendar-week me-1"></i> Theo tuần
                </a>
                <a asp-action="Index" asp-route-period="month"
                   class="btn @(Model.Period == "month" ? "btn-huit" : "btn-outline-huit") d-inline-flex align-items-center px-3"
                   style="min-height: 44px;">
                    <i class="bi bi-calendar3 me-1"></i> Theo tháng
                </a>
            </div>
            <a asp-action="ExportCsv" asp-route-period="@Model.Period"
               class="btn btn-outline-orange d-inline-flex align-items-center px-3"
               style="min-height: 44px;">
                <i class="bi bi-filetype-csv me-2"></i> Xuất báo cáo CSV
            </a>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4" data-stagger-group>
        <div class="col" data-reveal="up">
            <div class="hl-bento-card stat-card h-100 p-3 p-md-4" data-tilt-3d>
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div class="min-w-0">
                        <div class="small text-muted fw-semibold">Tổng doanh thu (GMV)</div>
                        <div class="fs-4 fw-bold text-orange mt-1 text-nowrap">@Model.TotalGrossRevenue.ToString("N0") đ</div>
                        <div class="small text-muted mt-2">
                            Chiết khấu hiện hành: <span class="badge badge-huit">@Model.CurrentCommissionRate.ToString("0.#")%</span>
                        </div>
                    </div>
                    <div class="stat-icon flex-shrink-0"><i class="bi bi-currency-dollar"></i></div>
                </div>
            </div>
        </div>
        <div class="col" data-reveal="up" data-reveal-delay="80">
            <div class="hl-bento-card stat-card h-100 p-3 p-md-4" data-tilt-3d>
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div class="min-w-0 flex-grow-1">
                        <div class="small text-muted fw-semibold">Phân chia hoa hồng</div>
                        <div class="fw-bold text-huit mt-1 text-nowrap">Sàn: @Model.TotalPlatformCommission.ToString("N0") đ</div>
                        <div class="small text-muted mt-1 text-nowrap">GV nhận: <strong class="text-dark">@Model.TotalInstructorPayout.ToString("N0") đ</strong></div>
                    </div>
                    <div class="stat-icon flex-shrink-0"><i class="bi bi-pie-chart-fill"></i></div>
                </div>
                <div class="progress mt-3" style="height: 6px; border-radius: 999px;">
                    <div class="progress-bar" style="width: @platformSharePct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%; background-color: #1D4ED8;" title="Sàn HUIT Learning"></div>
                    <div class="progress-bar" style="width: @instructorSharePct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%; background-color: #F97316;" title="Giảng viên"></div>
                </div>
            </div>
        </div>
        <div class="col" data-reveal="up" data-reveal-delay="160">
            <div class="hl-bento-card stat-card h-100 p-3 p-md-4" data-tilt-3d>
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div class="min-w-0">
                        <div class="small text-muted fw-semibold">Người dùng hệ thống</div>
                        <div class="fs-3 fw-bold text-dark mt-1" data-count-to="@Model.TotalUsers">@Model.TotalUsers</div>
                        <div class="small text-warning-emphasis mt-1">
                            Hồ sơ GV chờ duyệt: <strong data-count-to="@Model.PendingInstructorRequests">@Model.PendingInstructorRequests</strong>
                        </div>
                    </div>
                    <div class="stat-icon flex-shrink-0"><i class="bi bi-people-fill"></i></div>
                </div>
            </div>
        </div>
        <div class="col" data-reveal="up" data-reveal-delay="240">
            <div class="hl-bento-card stat-card h-100 p-3 p-md-4" data-tilt-3d>
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div class="min-w-0">
                        <div class="small text-muted fw-semibold">Tổng khóa học</div>
                        <div class="fs-3 fw-bold text-dark mt-1" data-count-to="@Model.TotalCourses">@Model.TotalCourses</div>
                        <div class="small text-orange mt-1">
                            Khóa chờ duyệt: <strong data-count-to="@Model.PendingCourses">@Model.PendingCourses</strong>
                        </div>
                    </div>
                    <div class="stat-icon flex-shrink-0"><i class="bi bi-journal-check"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-lg-7" data-reveal="up">
            <div class="hl-bento-card p-3 p-md-4 h-100">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <div class="hl-eyebrow">Phân tích tài chính</div>
                        <h2 class="h6 fw-bold mb-0">
                            <i class="bi bi-bar-chart-steps text-huit me-1"></i>
                            Doanh thu &amp; Phân chia hoa hồng (@(Model.Period == "week" ? "8 tuần gần nhất" : "6 tháng gần nhất"))
                        </h2>
                    </div>
                    <span class="badge badge-huit">@(Model.Period == "week" ? "Chu kỳ tuần" : "Chu kỳ tháng")</span>
                </div>
                <div style="position: relative; min-height: 280px;">
                    <canvas id="adminRevenueChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-5" data-reveal="up" data-reveal-delay="80">
            <div class="hl-bento-card p-3 p-md-4 h-100">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <div class="hl-eyebrow">Tăng trưởng cộng đồng</div>
                        <h2 class="h6 fw-bold mb-0">
                            <i class="bi bi-graph-up text-orange me-1"></i>
                            Biến động tài khoản &amp; Ghi danh mới
                        </h2>
                    </div>
                    <span class="badge badge-orange">Realtime</span>
                </div>
                <div style="position: relative; min-height: 280px;">
                    <canvas id="adminUsersChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="hl-bento-card p-3 p-md-4" data-reveal="up">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-3">
            <div>
                <div class="hl-eyebrow">Hiệu suất đào tạo</div>
                <h2 class="h5 fw-bold mb-0">Khóa học có tương tác cao trên HUIT Learning</h2>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-area="Admin" asp-controller="Courses" asp-action="Index"
                   class="btn btn-outline-orange d-inline-flex align-items-center px-3"
                   style="min-height: 44px;">
                    <i class="bi bi-shield-check me-2"></i> Kiểm duyệt khóa học
                </a>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Khóa học</th>
                        <th>Giảng viên</th>
                        <th class="text-nowrap">Học viên</th>
                        <th class="text-nowrap">Tiến độ TB</th>
                        <th class="text-nowrap">Đánh giá TB</th>
                        <th class="text-end text-nowrap">Doanh thu</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.TopCourses.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-bar-chart fs-3 d-block mb-2 opacity-50"></i>
                                Chưa có dữ liệu thống kê khóa học.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var c in Model.TopCourses)
                        {
                            <tr>
                                <td class="fw-semibold" style="min-width: 220px;">
                                    <a asp-area="Admin" asp-controller="Courses" asp-action="Details" asp-route-id="@c.CourseId"
                                       class="text-dark text-decoration-none d-inline-flex align-items-center gap-2">
                                        <span class="badge badge-huit rounded-pill"><i class="bi bi-journal-bookmark"></i></span>
                                        <span>@c.Title</span>
                                    </a>
                                </td>
                                <td class="small text-muted text-nowrap">@c.InstructorName</td>
                                <td class="text-nowrap"><span class="badge badge-orange">@c.EnrollmentCount</span></td>
                                <td style="min-width: 150px;">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress progress-orange flex-grow-1" style="height: 6px;">
                                            <div class="progress-bar" style="width: @c.AvgProgressPercent.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                        </div>
                                        <span class="small fw-semibold text-nowrap">@c.AvgProgressPercent.ToString("0.#")%</span>
                                    </div>
                                </td>
                                <td class="small text-nowrap fw-semibold">
                                    @if (c.AvgRating > 0)
                                    {
                                        <span class="text-warning"><i class="bi bi-star-fill me-1"></i></span>@($"{c.AvgRating:0.0}")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end fw-bold text-orange text-nowrap">@c.Revenue.ToString("N0") đ</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        const labels = @Html.Raw(labelsJson);
        new Chart(document.getElementById('adminRevenueChart'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Hoa hồng HUIT Learning',
                        data: @Html.Raw(platformJson),
                        backgroundColor: '#1D4ED8',
                        borderRadius: 6,
                        maxBarThickness: 36
                    },
                    {
                        label: 'Phần Giảng viên',
                        data: @Html.Raw(instructorJson),
                        backgroundColor: '#F97316',
                        borderRadius: 6,
                        maxBarThickness: 36
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { usePointStyle: true, padding: 16 }
                    }
                },
                scales: {
                    x: { stacked: true, grid: { display: false } },
                    y: { stacked: true, beginAtZero: true, grid: { color: 'rgba(148, 163, 184, 0.18)' } }
                }
            }
        });

        new Chart(document.getElementById('adminUsersChart'), {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Tài khoản mới',
                        data: @Html.Raw(usersJson),
                        borderColor: '#F97316',
                        backgroundColor: 'rgba(249, 115, 22, 0.14)',
                        pointBackgroundColor: '#F97316',
                        borderWidth: 2.5,
                        fill: true,
                        tension: 0.35
                    },
                    {
                        label: 'Đăng ký khóa mới',
                        data: @Html.Raw(enrollsJson),
                        borderColor: '#1D4ED8',
                        backgroundColor: 'rgba(29, 78, 216, 0.08)',
                        pointBackgroundColor: '#1D4ED8',
                        borderWidth: 2.5,
                        fill: true,
                        tension: 0.35
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { usePointStyle: true, padding: 16 }
                    }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true, grid: { color: 'rgba(148, 163, 184, 0.18)' } }
                }
            }
        });
    </script>
}
