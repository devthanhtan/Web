@page
@model QuanLiKhoaHocTrucTuyen.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu - HUIT Learning";
}

<section class="hl-section py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5">
            <div class="hl-bento-card app-card p-4 p-md-5 shadow-sm" data-reveal="up">
                <div class="text-center mb-4">
                    <div class="stat-icon mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.5rem;">
                        <i class="bi bi-key-fill" aria-hidden="true"></i>
                    </div>
                    <span class="hl-eyebrow text-orange">Khôi phục truy cập</span>
                    <h1 class="h4 fw-bold mt-1 mb-1">Quên mật khẩu</h1>
                    <p class="small text-muted mb-0">Hệ thống tài khoản học tập số HUIT Learning</p>
                </div>

                @if (Model.Sent)
                {
                    <div class="alert alert-success small rounded-3 mb-4">
                        <i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i>
                        Nếu địa chỉ email tồn tại và đã xác thực, hệ thống <strong>HUIT Learning</strong> đã gửi hướng dẫn đặt lại mật khẩu tới hộp thư của bạn.
                    </div>
                    <a asp-page="./Login" class="btn btn-orange rounded-pill w-100 py-2 fw-semibold">
                        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Quay lại đăng nhập
                    </a>
                }
                else
                {
                    <p class="small text-muted mb-3">Nhập địa chỉ email tài khoản của bạn để nhận liên kết đặt lại mật khẩu an toàn.</p>
                    <form method="post">
                        <div asp-validation-summary="All" class="text-danger small mb-2"></div>
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label fw-semibold small">Email đăng ký</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope" aria-hidden="true"></i></span>
                                <input asp-for="Input.Email" class="form-control" placeholder="ten@email.com" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-orange rounded-pill w-100 py-2 fw-semibold mb-3">
                            <i class="bi bi-send me-1" aria-hidden="true"></i> Gửi liên kết khôi phục
                        </button>
                        <div class="text-center small">
                            <a asp-page="./Login" class="text-muted text-decoration-none"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Quay lại trang đăng nhập</a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
