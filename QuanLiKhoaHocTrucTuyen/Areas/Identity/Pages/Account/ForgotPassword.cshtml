@page
@model QuanLiKhoaHocTrucTuyen.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-7 col-lg-5">
        <div class="app-card p-4">
            <h1 class="h4 mb-2">Khôi phục mật khẩu</h1>
            @if (Model.Sent)
            {
                <div class="alert alert-success small mb-3">
                    Nếu email tồn tại và đã xác thực, hệ thống đã gửi hướng dẫn đặt lại mật khẩu tới hộp thư của bạn.
                </div>
                <a asp-page="./Login" class="btn btn-outline-orange w-100">Quay lại đăng nhập</a>
            }
            else
            {
                <p class="small text-muted mb-3">Nhập email tài khoản của bạn để nhận liên kết đặt lại mật khẩu.</p>
                <form method="post">
                    <div asp-validation-summary="All" class="text-danger small mb-2"></div>
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label fw-semibold">Email</label>
                        <input asp-for="Input.Email" class="form-control" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-orange w-100">Gửi yêu cầu</button>
                </form>
            }
        </div>
    </div>
</div>
