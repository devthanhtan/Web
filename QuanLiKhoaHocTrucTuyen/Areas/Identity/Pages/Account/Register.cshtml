@page
@model QuanLiKhoaHocTrucTuyen.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="app-card p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="brand-icon mx-auto mb-3 d-inline-flex align-items-center justify-content-center" style="width:48px;height:48px;border-radius:14px;background:linear-gradient(135deg,#ff6b00,#ea580c);color:#fff;">
                    <i class="bi bi-person-plus-fill fs-4"></i>
                </div>
                <h1 class="h3 mb-1">Tạo tài khoản EduSpark</h1>
                <p class="text-muted small mb-0">Bắt đầu học tập hàng trăm khóa học chất lượng cao</p>
            </div>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.FullName" class="form-label fw-semibold"></label>
                    <input asp-for="Input.FullName" class="form-control" placeholder="Nguyễn Văn A" />
                    <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label fw-semibold"></label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="ten@email.com" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label fw-semibold"></label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Ít nhất 8 ký tự gồm chữ và số" />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold"></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Nhập lại mật khẩu" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <button id="registerSubmit" type="submit" class="btn btn-orange w-100 py-2">
                    <i class="bi bi-check2-circle me-1"></i> Đăng ký ngay
                </button>
            </form>

            @if (Model.ExternalLogins.Count > 0)
            {
                <div class="text-center my-3 text-muted small">hoặc đăng ký nhanh bằng</div>
                <form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    @foreach (var provider in Model.ExternalLogins)
                    {
                        <button type="submit" class="btn btn-outline-secondary w-100" name="provider" value="@provider.Name">
                            <i class="bi bi-google text-danger me-2"></i> Tiếp tục với @provider.DisplayName
                        </button>
                    }
                </form>
            }

            <div class="text-center mt-4 small">
                Đã có tài khoản? <a asp-page="./Login" class="fw-semibold">Đăng nhập</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
