@page
@{
    ViewData["Title"] = "Tài khoản bị khóa";
}
<div class="row justify-content-center py-5">
    <div class="col-md-6">
        <div class="app-card p-5 text-center">
            <div class="stat-icon mx-auto mb-3 text-danger bg-danger-subtle" style="width:64px;height:64px;font-size:1.8rem;">
                <i class="bi bi-lock-fill"></i>
            </div>
            <h1 class="h4 text-danger mb-2">Tài khoản tạm thời bị khóa</h1>
            <p class="text-muted mb-4">Tài khoản này đang bị khóa do quyết định của Quản trị viên hoặc nhập sai mật khẩu quá số lần cho phép.</p>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-orange">Quay về trang chủ</a>
        </div>
    </div>
</div>
