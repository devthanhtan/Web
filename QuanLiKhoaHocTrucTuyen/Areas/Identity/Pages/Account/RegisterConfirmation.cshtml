@page
@model QuanLiKhoaHocTrucTuyen.Areas.Identity.Pages.Account.RegisterConfirmationModel
@{
    ViewData["Title"] = "Xác thực email";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="app-card p-4 p-md-5 text-center">
            <div class="stat-icon mx-auto mb-3" style="width:64px;height:64px;font-size:1.8rem;">
                <i class="bi bi-envelope-check"></i>
            </div>
            <h1 class="h3 mb-2">Kiểm tra email để kích hoạt tài khoản</h1>
            <p class="text-muted mb-4">
                Chúng tôi đã gửi liên kết xác thực tới địa chỉ <strong>@Model.Email</strong>.
                Tài khoản chỉ được kích hoạt sau khi bạn xác nhận email.
            </p>

            @if (Model.DisplayConfirmAccountLink && !string.IsNullOrEmpty(Model.EmailConfirmationUrl))
            {
                <div class="alert bg-orange-soft border border-warning-subtle text-start">
                    <div class="fw-bold mb-1"><i class="bi bi-terminal me-1"></i> Chế độ giả lập Email (UseMockServices = true)</div>
                    <p class="small mb-2">Email xác thực đã được lưu trong <code>App_Data/MockEmails</code>. Bạn có thể bấm nút bên dưới để xác thực ngay:</p>
                    <a id="confirm-link" href="@Model.EmailConfirmationUrl" class="btn btn-orange btn-sm">
                        <i class="bi bi-check2-circle me-1"></i> Xác thực email ngay
                    </a>
                </div>
            }

            <a asp-page="./Login" class="btn btn-outline-orange mt-2">Quay lại trang đăng nhập</a>
        </div>
    </div>
</div>
