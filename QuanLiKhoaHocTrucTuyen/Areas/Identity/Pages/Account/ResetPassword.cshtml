@page
@model QuanLiKhoaHocTrucTuyen.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu - HUIT Learning";
}

<section class="hl-section py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5">
            <div class="hl-bento-card app-card p-4 p-md-5 shadow-sm" data-reveal="up">
                <div class="text-center mb-4">
                    <div class="stat-icon mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.5rem;">
                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                    </div>
                    <span class="hl-eyebrow text-orange">Bảo mật tài khoản</span>
                    <h1 class="h4 fw-bold mt-1 mb-1">Thiết lập mật khẩu mới</h1>
                    <p class="small text-muted mb-0">Cập nhật mật khẩu bảo vệ tài khoản HUIT Learning của bạn</p>
                </div>

                @if (Model.ResetSucceeded)
                {
                    <div class="alert alert-success small rounded-3 mb-4">
                        <i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i> Mật khẩu của bạn đã được cập nhật thành công.
                    </div>
                    <a asp-page="./Login" class="btn btn-orange rounded-pill w-100 py-2 fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i> Đăng nhập ngay
                    </a>
                }
                else
                {
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                        <input asp-for="Input.Code" type="hidden" />
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label fw-semibold small">Email</label>
                            <input asp-for="Input.Email" class="form-control" placeholder="ten@email.com" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label fw-semibold small">Mật khẩu mới</label>
                            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Tối thiểu 8 ký tự" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold small">Xác nhận mật khẩu</label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-orange rounded-pill w-100 py-2 fw-semibold">
                            <i class="bi bi-check2-circle me-1" aria-hidden="true"></i> Xác nhận đặt lại mật khẩu
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
