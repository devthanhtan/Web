@page
@model QuanLiKhoaHocTrucTuyen.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-7 col-lg-5">
        <div class="app-card p-4">
            <h1 class="h4 mb-3">Đặt lại mật khẩu mới</h1>
            @if (Model.ResetSucceeded)
            {
                <div class="alert alert-success small mb-3">Mật khẩu của bạn đã được cập nhật.</div>
                <a asp-page="./Login" class="btn btn-orange w-100">Đăng nhập ngay</a>
            }
            else
            {
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                    <input asp-for="Input.Code" type="hidden" />
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label fw-semibold">Email</label>
                        <input asp-for="Input.Email" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label fw-semibold">Mật khẩu mới</label>
                        <input asp-for="Input.Password" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">Xác nhận mật khẩu</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-orange w-100">Xác nhận đặt lại</button>
                </form>
            }
        </div>
    </div>
</div>
