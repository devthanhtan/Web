@page
@model QuanLiKhoaHocTrucTuyen.Areas.Identity.Pages.Account.ConfirmEmailModel
@{
    ViewData["Title"] = "Kết quả xác thực email";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-7 col-lg-5">
        <div class="app-card p-4 p-md-5 text-center">
            @if (Model.IsSuccess)
            {
                <div class="stat-icon mx-auto mb-3 text-success bg-success-subtle" style="width:64px;height:64px;font-size:1.8rem;">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <h1 class="h4 mb-2">Kích hoạt thành công!</h1>
                <p class="text-muted mb-4">@Model.StatusMessage</p>
                <a asp-page="./Login" class="btn btn-orange px-4">Đăng nhập ngay</a>
            }
            else
            {
                <div class="stat-icon mx-auto mb-3 text-danger bg-danger-subtle" style="width:64px;height:64px;font-size:1.8rem;">
                    <i class="bi bi-x-circle-fill"></i>
                </div>
                <h1 class="h4 mb-2">Xác thực thất bại</h1>
                <p class="text-muted mb-4">@Model.StatusMessage</p>
                <a asp-page="./ResendEmailConfirmation" class="btn btn-outline-orange">Gửi lại email xác thực</a>
            }
        </div>
    </div>
</div>
