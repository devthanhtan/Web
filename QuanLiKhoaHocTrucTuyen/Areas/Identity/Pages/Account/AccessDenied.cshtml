@page
@{
    ViewData["Title"] = "Không có quyền truy cập";
}
<div class="row justify-content-center py-5">
    <div class="col-md-6">
        <div class="app-card p-5 text-center">
            <div class="stat-icon mx-auto mb-3 text-danger bg-danger-subtle" style="width:64px;height:64px;font-size:1.8rem;">
                <i class="bi bi-shield-exclamation"></i>
            </div>
            <h1 class="h4 text-danger mb-2">Không có quyền truy cập</h1>
            <p class="text-muted mb-4">Tài khoản của bạn không có quyền thực hiện chức năng này.</p>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-orange">Quay về trang chủ</a>
        </div>
    </div>
</div>
