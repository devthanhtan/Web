@page
@model QuanLiKhoaHocTrucTuyen.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="app-card p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="brand-icon mx-auto mb-3 d-inline-flex align-items-center justify-content-center" style="width:48px;height:48px;border-radius:14px;background:linear-gradient(135deg,#ff6b00,#ea580c);color:#fff;">
                    <i class="bi bi-box-arrow-in-right fs-4"></i>
                </div>
                <h1 class="h3 mb-1">Đăng nhập EduSpark</h1>
                <p class="text-muted small mb-0">Chào mừng bạn quay lại học tập và giảng dạy</p>
            </div>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label fw-semibold"></label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="ten@email.com" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label fw-semibold"></label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4 small">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label class="form-check-label" asp-for="Input.RememberMe"></label>
                    </div>
                    <a asp-page="./ForgotPassword">Quên mật khẩu?</a>
                </div>

                <button id="login-submit" type="submit" class="btn btn-orange w-100 py-2">
                    <i class="bi bi-door-open me-1"></i> Đăng nhập
                </button>
            </form>

            @if (Model.ExternalLogins.Count > 0)
            {
                <div class="text-center my-3 text-muted small">hoặc đăng nhập với</div>
                <form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    @foreach (var provider in Model.ExternalLogins)
                    {
                        <button type="submit" class="btn btn-outline-secondary w-100" name="provider" value="@provider.Name">
                            <i class="bi bi-google text-danger me-2"></i> Đăng nhập bằng @provider.DisplayName
                        </button>
                    }
                </form>
            }

            <div class="text-center mt-3 small">
                Chưa có tài khoản? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold">Đăng ký ngay</a>
                <span class="mx-1 text-muted">|</span>
                <a asp-page="./ResendEmailConfirmation">Gửi lại email xác thực</a>
            </div>

            <div class="mt-4 pt-3 border-top">
                <button class="btn btn-sm btn-light w-100 text-muted" type="button" data-bs-toggle="collapse" data-bs-target="#demoAccountsBox">
                    <i class="bi bi-key me-1 text-orange"></i> Xem tài khoản mẫu dùng thử
                </button>
                <div class="collapse mt-2" id="demoAccountsBox">
                    <div class="p-3 bg-orange-soft rounded small">
                        <div><strong>Admin:</strong> <code>admin@eduspark.vn</code> / <code>Admin12345</code></div>
                        <div><strong>Giảng viên:</strong> <code>instructor@eduspark.vn</code> / <code>Instructor12345</code></div>
                        <div><strong>Học viên:</strong> <code>student@eduspark.vn</code> / <code>Student12345</code></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
