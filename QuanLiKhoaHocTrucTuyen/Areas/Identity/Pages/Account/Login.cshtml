@page
@model QuanLiKhoaHocTrucTuyen.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng nhập - HUIT Learning";
}

<style>
    .hl-auth-shell {
        border-radius: 1.5rem;
        overflow: hidden;
        border: 1px solid rgba(15, 23, 42, 0.08);
        box-shadow: 0 24px 48px -20px rgba(15, 23, 42, 0.14);
        background: #ffffff;
    }

    .hl-auth-brand-panel {
        background:
            radial-gradient(circle at 82% 18%, rgba(249, 115, 22, 0.25), transparent 46%),
            radial-gradient(circle at 12% 88%, rgba(56, 189, 248, 0.2), transparent 48%),
            linear-gradient(150deg, #0b162c 0%, #102a5c 58%, #0f172a 100%);
        color: #ffffff;
    }
</style>

<section class="hl-section py-3 py-md-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="hl-auth-shell" data-reveal="up">
                <div class="row g-0">
                    <!-- LEFT BRAND PANEL -->
                    <div class="col-12 col-lg-5 hl-auth-brand-panel p-4 p-md-5 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-inline-flex align-items-center gap-2 mb-4">
                                <span class="d-inline-flex align-items-center justify-content-center rounded-3 shadow-sm"
                                      style="width: 44px; height: 44px; background: linear-gradient(135deg, #1d4ed8, #f97316); color: #fff;">
                                    <i class="bi bi-mortarboard-fill fs-5" aria-hidden="true"></i>
                                </span>
                                <span class="fw-bold fs-5 tracking-tight">HUIT Learning</span>
                            </div>

                            <span class="hl-eyebrow text-warning d-block mb-2">Cổng học tập số thế hệ mới</span>
                            <h2 class="h3 fw-bold text-white mb-3 lh-sm">
                                Tiếp nối hành trình chinh phục tri thức cùng HUIT Learning
                            </h2>
                            <p class="small text-white-50 mb-4">
                                Truy cập ngay kho bài giảng HD, tiếp tục tiến độ học tập đã đồng bộ từng giây và theo dõi chứng chỉ điện tử định danh mã QR.
                            </p>
                        </div>

                        <ul class="list-unstyled small text-white-50 vstack gap-2 mb-0 pt-3 border-top border-white border-opacity-10">
                            <li><i class="bi bi-check-circle-fill text-orange me-2" aria-hidden="true"></i>Đồng bộ tiến độ video trên mọi thiết bị</li>
                            <li><i class="bi bi-check-circle-fill text-orange me-2" aria-hidden="true"></i>Phòng thi trắc nghiệm tính giờ tự động</li>
                            <li><i class="bi bi-check-circle-fill text-orange me-2" aria-hidden="true"></i>Chứng chỉ số PDF tích hợp QR xác thực 24/7</li>
                        </ul>
                    </div>

                    <!-- RIGHT AUTH FORM PANEL -->
                    <div class="col-12 col-lg-7 p-4 p-md-5">
                        <div class="mb-4">
                            <span class="hl-eyebrow text-orange">Tài khoản thành viên</span>
                            <h1 class="h3 fw-bold mt-1 mb-1">Đăng nhập hệ thống</h1>
                            <p class="text-muted small mb-0">Chào mừng bạn quay lại hệ sinh thái học tập &amp; giảng dạy số</p>
                        </div>

                        <form id="account" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3 py-2" role="alert"></div>

                            <div class="mb-3">
                                <label asp-for="Input.Email" class="form-label fw-semibold small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope" aria-hidden="true"></i></span>
                                    <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="ten@email.com" />
                                </div>
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label asp-for="Input.Password" class="form-label fw-semibold small mb-1"></label>
                                    <a asp-page="./ForgotPassword" class="small text-decoration-none">Quên mật khẩu?</a>
                                </div>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-lock" aria-hidden="true"></i></span>
                                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu của bạn" />
                                </div>
                                <span asp-validation-for="Input.Password" class="text-danger small"></span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-4 small">
                                <div class="form-check">
                                    <input class="form-check-input" asp-for="Input.RememberMe" />
                                    <label class="form-check-label" asp-for="Input.RememberMe"></label>
                                </div>
                            </div>

                            <button id="login-submit" type="submit" class="btn btn-orange rounded-pill w-100 py-2 fw-semibold">
                                <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i> Đăng nhập hệ thống
                            </button>
                        </form>

                        @if (Model.ExternalLogins.Count > 0)
                        {
                            <div class="text-center my-3 text-muted small">hoặc tiếp tục với</div>
                            <form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                <div class="vstack gap-2">
                                    @foreach (var provider in Model.ExternalLogins)
                                    {
                                        <button type="submit" class="btn btn-outline-secondary rounded-pill w-100 py-2" name="provider" value="@provider.Name">
                                            <i class="bi bi-google text-danger me-2" aria-hidden="true"></i> Đăng nhập bằng @provider.DisplayName
                                        </button>
                                    }
                                </div>
                            </form>
                        }

                        <div class="text-center mt-4 small">
                            <div>
                                Chưa có tài khoản?
                                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold text-decoration-none">Đăng ký miễn phí</a>
                            </div>
                            <div class="mt-1">
                                <a asp-page="./ResendEmailConfirmation" class="text-muted text-decoration-none">Gửi lại email kích hoạt tài khoản</a>
                            </div>
                        </div>

                        <!-- QUICK-FILL DEMO ACCOUNTS -->
                        <div class="mt-4 pt-3 border-top">
                            <button class="btn btn-sm btn-light border rounded-pill w-100 text-dark py-2" type="button" data-bs-toggle="collapse" data-bs-target="#demoAccountsBox" aria-expanded="false" aria-controls="demoAccountsBox">
                                <i class="bi bi-key-fill me-1 text-orange" aria-hidden="true"></i> Tài khoản mẫu trải nghiệm nhanh
                            </button>
                            <div class="collapse mt-2" id="demoAccountsBox">
                                <div class="p-3 bg-light border rounded-4 small vstack gap-2">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-1">
                                        <span><strong>Quản trị:</strong> <code>admin@eduspark.vn</code> / <code>Admin12345</code></span>
                                        <button type="button" class="btn btn-sm btn-outline-huit rounded-pill py-0 px-3 demo-fill-btn" data-email="admin@eduspark.vn" data-pass="Admin12345">Điền</button>
                                    </div>
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-1">
                                        <span><strong>Giảng viên:</strong> <code>instructor@eduspark.vn</code> / <code>Instructor12345</code></span>
                                        <button type="button" class="btn btn-sm btn-outline-huit rounded-pill py-0 px-3 demo-fill-btn" data-email="instructor@eduspark.vn" data-pass="Instructor12345">Điền</button>
                                    </div>
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-1">
                                        <span><strong>Học viên:</strong> <code>student@eduspark.vn</code> / <code>Student12345</code></span>
                                        <button type="button" class="btn btn-sm btn-outline-huit rounded-pill py-0 px-3 demo-fill-btn" data-email="student@eduspark.vn" data-pass="Student12345">Điền</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.demo-fill-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const emailInput = document.getElementById('Input_Email');
                const passInput = document.getElementById('Input_Password');
                if (emailInput && passInput) {
                    emailInput.value = this.dataset.email || '';
                    passInput.value = this.dataset.pass || '';
                    emailInput.focus();
                }
            });
        });
    </script>
}
