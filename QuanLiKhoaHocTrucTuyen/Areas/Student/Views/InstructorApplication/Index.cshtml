@model QuanLiKhoaHocTrucTuyen.Areas.Student.ViewModels.InstructorApplicationViewModel
@{
    ViewData["Title"] = "Đăng ký làm Giảng viên";
    ViewData["AreaTitle"] = "Nâng cấp Giảng viên";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="app-card p-4">
            <h1 class="h4 mb-1">Đăng ký nâng cấp lên Giảng viên</h1>
            <p class="text-muted small mb-4">Gửi hồ sơ năng lực (CV và chứng chỉ chuyên môn) để Admin thẩm định và mở Dashboard Giảng viên.</p>

            @if (Model.IsAlreadyInstructor)
            {
                <div class="alert alert-success border-0">
                    <i class="bi bi-check-circle-fill me-2"></i> Tài khoản của bạn đã có quyền <strong>Giảng viên</strong>!
                    <a asp-area="Instructor" asp-controller="Dashboard" asp-action="Index" class="btn btn-sm btn-orange ms-2">Mở Kênh Giảng viên</a>
                </div>
            }
            else if (Model.LatestRequest != null)
            {
                if (Model.LatestRequest.Status == InstructorRequestStatus.Pending)
                {
                    <div class="alert alert-warning border-0">
                        <h2 class="h6 fw-bold mb-1"><i class="bi bi-hourglass-split me-1"></i> Hồ sơ đang chờ Admin thẩm định</h2>
                        <p class="small mb-2">Đã gửi lúc @Model.LatestRequest.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · Chuyên môn: <strong>@Model.LatestRequest.Expertise</strong></p>
                        <a href="@Model.LatestRequest.CvFilePath" target="_blank" class="btn btn-sm btn-outline-secondary">Xem lại CV đã nộp</a>
                    </div>
                }
                else if (Model.LatestRequest.Status == InstructorRequestStatus.Approved)
                {
                    <div class="alert alert-success border-0">
                        <h2 class="h6 fw-bold mb-1"><i class="bi bi-patch-check-fill me-1"></i> Hồ sơ đã được phê duyệt</h2>
                        <p class="small mb-0">Vui lòng đăng xuất và đăng nhập lại nếu bạn chưa thấy menu Kênh Giảng viên.</p>
                    </div>
                }
                else if (Model.LatestRequest.Status == InstructorRequestStatus.Rejected)
                {
                    <div class="alert alert-danger border-0 mb-4">
                        <h2 class="h6 fw-bold mb-1"><i class="bi bi-x-octagon-fill me-1"></i> Yêu cầu trước đó bị từ chối</h2>
                        <p class="small mb-1"><strong>Lý do từ Admin:</strong> @Model.LatestRequest.RejectionReason</p>
                        <p class="small mb-0">Bạn có thể bổ sung thông tin, tải lại CV/chứng chỉ mới và gửi xét duyệt lại bên dưới.</p>
                    </div>
                }
            }

            @if (!Model.IsAlreadyInstructor && (Model.LatestRequest == null || Model.LatestRequest.Status == InstructorRequestStatus.Rejected))
            {
                <form asp-action="Index" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Expertise" class="form-label fw-semibold"></label>
                            <input asp-for="Expertise" class="form-control" placeholder="Ví dụ: Lập trình ASP.NET Core & SQL Server" />
                            <span asp-validation-for="Expertise" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ExperienceYears" class="form-label fw-semibold"></label>
                            <input asp-for="ExperienceYears" type="number" min="0" max="60" class="form-control" />
                            <span asp-validation-for="ExperienceYears" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Bio" class="form-label fw-semibold"></label>
                            <textarea asp-for="Bio" rows="4" class="form-control" placeholder="Mô tả kinh nghiệm giảng dạy, dự án thực tế và khóa học dự kiến xây dựng..."></textarea>
                            <span asp-validation-for="Bio" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CvFile" class="form-label fw-semibold"></label>
                            <input asp-for="CvFile" type="file" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg,.txt" class="form-control" />
                            <span asp-validation-for="CvFile" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CertificateFile" class="form-label fw-semibold"></label>
                            <input asp-for="CertificateFile" type="file" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg,.txt" class="form-control" />
                            <span asp-validation-for="CertificateFile" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-orange px-4">
                            <i class="bi bi-send-check me-1"></i> Gửi hồ sơ xét duyệt
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
