@model QuanLiKhoaHocTrucTuyen.Areas.Student.ViewModels.LearningRoomViewModel
@{
    ViewData["Title"] = $"Học: {Model.Course.Title}";
    ViewData["AreaTitle"] = "Không gian học tập";
    var lesson = Model.CurrentLesson;
    var watchedSec = Model.CurrentProgress?.WatchedSeconds ?? 0;
    var lastPosSec = Model.CurrentProgress?.LastPositionSeconds ?? 0;
    var isCurrentCompleted = Model.CurrentProgress?.IsCompleted == true;
    var finalExam = Model.Course.Quizzes.FirstOrDefault(q => q.IsFinalExam);
    var chapterQuizzes = Model.Course.Quizzes.Where(q => !q.IsFinalExam && q.ChapterId.HasValue).ToList();
    var courseThumb = string.IsNullOrEmpty(Model.Course.ThumbnailUrl) ? "/images/course-default.svg" : Model.Course.ThumbnailUrl;
}

@Html.AntiForgeryToken()

<!-- Compact Cinema Learning Progress Header -->
<div class="hl-bento-card p-3 p-md-4 mb-4" data-reveal="up">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3 min-w-0">
            <a asp-area="Student" asp-controller="Dashboard" asp-action="Index"
               class="btn btn-outline-huit btn-sm d-inline-flex align-items-center justify-content-center flex-shrink-0"
               style="min-width: 44px; min-height: 44px;" title="Quay lại khóa học của tôi">
                <i class="bi bi-arrow-left"></i>
            </a>
            <img src="@courseThumb"
                 onerror="this.onerror=null;this.src='/images/course-default.svg';"
                 alt="@Model.Course.Title"
                 class="rounded-3 d-none d-sm-block flex-shrink-0 border"
                 style="width: 84px; height: 48px; object-fit: cover; view-transition-name: course-thumb-@Model.Course.Id;" />
            <div class="min-w-0">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <span class="hl-eyebrow">@Model.Course.Category.Name</span>
                    <span class="small text-muted"><i class="bi bi-person-video3 me-1"></i>GV: @Model.Course.Instructor.FullName</span>
                </div>
                <h1 class="h5 fw-bold mb-0 text-truncate" title="@Model.Course.Title">@Model.Course.Title</h1>
            </div>
        </div>

        <div class="flex-shrink-0" style="min-width: 260px;">
            <div class="d-flex justify-content-between align-items-center small fw-semibold mb-1 gap-2">
                <span>Tiến độ: <strong id="completedCountSpan">@Model.CompletedLessonsCount</strong> / @Model.TotalLessonsCount bài</span>
                <span class="badge badge-orange" id="courseProgressText">@Model.Enrollment.ProgressPercent.ToString("0.#")%</span>
            </div>
            <div class="progress progress-orange" style="height: 8px;">
                <div id="courseProgressBar" class="progress-bar" role="progressbar"
                     style="width: @Model.Enrollment.ProgressPercent.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
            </div>
            <div class="d-flex d-xl-none mt-2">
                <button type="button" class="btn btn-sm btn-outline-orange w-100 d-inline-flex align-items-center justify-content-center"
                        style="min-height: 44px;" id="jumpToPlaylistBtn">
                    <i class="bi bi-collection-play me-2"></i> Mở danh sách bài học (@Model.CompletedLessonsCount/@Model.TotalLessonsCount)
                </button>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 align-items-start">
    <!-- Cinema Theater Stage + Scrollable Pill Tabs -->
    <div class="col-12 col-xl-8">
        @if (lesson == null)
        {
            <div class="hl-bento-card p-5 text-center text-muted" data-reveal="up">
                <i class="bi bi-journal-x fs-1 text-orange d-block mb-2"></i>
                Khóa học này chưa có bài học nào.
            </div>
        }
        else
        {
            <!-- Cinema Learning Theater v2 Stage -->
            <div class="hl-bento-card p-0 overflow-hidden mb-4 border-0 shadow-sm" data-reveal="up">
                @if (lesson.LessonType == LessonType.Video)
                {
                    bool useLocalVideo = !string.IsNullOrEmpty(lesson.LocalVideoPath) && (lesson.YoutubeVideoId?.StartsWith("MOCK_") == true);

                    <!-- Dark Cinema Stage -->
                    <div class="p-2 p-md-3" style="background: linear-gradient(180deg, #0b1120 0%, #111827 100%);">
                        <div class="ratio ratio-16x9 rounded-3 overflow-hidden bg-black shadow">
                            @if (useLocalVideo)
                            {
                                <video id="localVideoPlayer" controls playsinline class="w-100 h-100" style="object-fit: contain; background: #000;">
                                    <source src="@lesson.LocalVideoPath" />
                                </video>
                            }
                            else if (!string.IsNullOrEmpty(lesson.YoutubeVideoId) && !lesson.YoutubeVideoId.StartsWith("MOCK_"))
                            {
                                <div id="ytPlayer" class="w-100 h-100"></div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center w-100 h-100 text-white p-4 text-center">
                                    <div>
                                        <i class="bi bi-film fs-1 text-orange d-block mb-2"></i>
                                        <div class="fw-semibold">Video chưa sẵn sàng (@lesson.VideoStatus)</div>
                                        <div class="small text-white-50 mt-1">Vui lòng quay lại sau khi hệ thống xử lý xong.</div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Anti-skip Telemetry Bar inside Cinema Stage -->
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2 px-2 py-1 small text-white-50">
                            <div>
                                <i class="bi bi-stopwatch text-orange me-1"></i>
                                Đã xem thực tế: <strong class="text-white" id="watchedSecondsSpan">@watchedSec</strong> / <strong class="text-white">@lesson.DurationSeconds</strong> giây
                                <span class="d-none d-sm-inline ms-1">(tự hoàn thành khi đạt ≥ 90%, chống tua nhanh)</span>
                            </div>
                            <div>
                                <i class="bi bi-bookmark-check text-orange me-1"></i>Vị trí lưu: <strong class="text-white" id="lastPosSpan">@lastPosSec</strong>s
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Document Reader Stage -->
                    <div class="p-3 p-md-4 bg-light border-bottom overflow-auto" style="max-height: 62vh;">
                        @if (!string.IsNullOrWhiteSpace(lesson.ContentHtml))
                        {
                            @Html.Raw(lesson.ContentHtml)
                        }
                        else
                        {
                            <p class="text-muted mb-0">@lesson.Description</p>
                        }
                    </div>
                }

                <!-- Lesson Metadata Strip -->
                <div class="p-3 p-md-4 bg-white">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="badge badge-orange">
                                <i class="bi @(lesson.LessonType == LessonType.Video ? "bi-play-circle-fill" : "bi-file-earmark-richtext") me-1"></i>
                                @(lesson.LessonType == LessonType.Video ? "Bài giảng Video" : "Bài đọc Tài liệu")
                            </span>
                            <h2 class="h5 fw-bold mb-0">@lesson.Title</h2>
                        </div>
                        <span id="lessonCompletionBadge" class="badge @(isCurrentCompleted ? "bg-success" : "bg-secondary") px-3 py-2 align-self-start align-self-sm-center">
                            <i class="bi @(isCurrentCompleted ? "bi-check-circle-fill" : "bi-clock") me-1"></i>
                            @(isCurrentCompleted ? "Đã hoàn thành" : "Chưa hoàn thành")
                        </span>
                    </div>

                    @if (lesson.LessonType != LessonType.Video)
                    {
                        <div class="alert alert-success border-0 small py-2 mt-3 mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill flex-shrink-0"></i>
                            <span>Bài học dạng tài liệu đã được hệ thống HUIT Learning ghi nhận hoàn thành khi bạn mở xem.</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Horizontally Scrollable Pill Tabs (.hl-pill-scroll): Nội dung / Tài liệu / Hỏi đáp / Đánh giá -->
            <div class="hl-bento-card p-3 p-md-4" data-reveal="up">
                <ul class="nav nav-pills hl-pill-scroll gap-2 mb-4 pb-1" role="tablist">
                    <li class="nav-item flex-shrink-0" role="presentation">
                        <button class="nav-link active fw-semibold rounded-pill px-3" data-bs-toggle="pill" data-bs-target="#tabDesc" type="button" role="tab" style="min-height: 42px;">
                            <i class="bi bi-info-circle me-1"></i>Nội dung
                        </button>
                    </li>
                    <li class="nav-item flex-shrink-0" role="presentation">
                        <button class="nav-link fw-semibold rounded-pill px-3" data-bs-toggle="pill" data-bs-target="#tabAttachments" type="button" role="tab" style="min-height: 42px;">
                            <i class="bi bi-paperclip me-1"></i>Tài liệu (@lesson.Attachments.Count)
                        </button>
                    </li>
                    <li class="nav-item flex-shrink-0" role="presentation">
                        <button class="nav-link fw-semibold rounded-pill px-3" data-bs-toggle="pill" data-bs-target="#tabQna" type="button" role="tab" style="min-height: 42px;">
                            <i class="bi bi-chat-left-dots me-1"></i>Hỏi đáp (@Model.Questions.Count)
                        </button>
                    </li>
                    <li class="nav-item flex-shrink-0" role="presentation">
                        <button class="nav-link fw-semibold rounded-pill px-3" data-bs-toggle="pill" data-bs-target="#tabReview" type="button" role="tab" style="min-height: 42px;">
                            <i class="bi bi-star me-1"></i>Đánh giá
                        </button>
                    </li>
                </ul>

                <div class="tab-content">
                    <!-- Tab 1: Nội dung -->
                    <div class="tab-pane fade show active" id="tabDesc" role="tabpanel">
                        <h3 class="h6 fw-bold mb-2">Mô tả bài học</h3>
                        <p class="mb-0 text-secondary">
                            @(string.IsNullOrWhiteSpace(lesson.Description) ? "Không có mô tả thêm cho bài học này." : lesson.Description)
                        </p>
                    </div>

                    <!-- Tab 2: Tài liệu -->
                    <div class="tab-pane fade" id="tabAttachments" role="tabpanel">
                        @if (lesson.Attachments.Any())
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var att in lesson.Attachments)
                                {
                                    <a asp-area="Student" asp-controller="Learn" asp-action="DownloadAttachment" asp-route-attachmentId="@att.Id"
                                       class="btn btn-outline-orange d-inline-flex align-items-center gap-2" style="min-height: 44px;">
                                        <i class="bi bi-download"></i>
                                        <span class="text-truncate" style="max-width: 240px;">@att.FileName</span>
                                        <span class="opacity-75 small">(@((att.FileSizeBytes / 1024.0).ToString("0.#")) KB)</span>
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted small bg-light rounded-3">
                                <i class="bi bi-folder2-open fs-4 d-block mb-1 text-huit"></i>
                                Bài học này không có tệp tài liệu đính kèm.
                            </div>
                        }
                    </div>

                    <!-- Tab 3: Hỏi đáp -->
                    <div class="tab-pane fade" id="tabQna" role="tabpanel">
                        <form asp-area="Student" asp-controller="Learn" asp-action="AskQuestion" method="post" class="mb-4">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="courseId" value="@Model.Course.Id" />
                            <input type="hidden" name="lessonId" value="@lesson.Id" />
                            <label class="form-label small fw-semibold">Đặt câu hỏi cho Giảng viên</label>
                            <div class="d-flex flex-column flex-sm-row gap-2">
                                <input type="text" name="questionText" class="form-control" required placeholder="Nhập thắc mắc của bạn về bài học này..." style="min-height: 44px;" />
                                <button type="submit" class="btn btn-orange flex-shrink-0 px-4" style="min-height: 44px;">
                                    <i class="bi bi-send me-1"></i> Gửi câu hỏi
                                </button>
                            </div>
                        </form>

                        @if (!Model.Questions.Any())
                        {
                            <div class="text-center py-4 text-muted small bg-light rounded-3">
                                <i class="bi bi-chat-square-quote fs-4 d-block mb-1 text-orange"></i>
                                Chưa có câu hỏi nào. Hãy là người đầu tiên trao đổi với giảng viên!
                            </div>
                        }
                        else
                        {
                            <div class="vstack gap-3">
                                @foreach (var q in Model.Questions)
                                {
                                    <div class="p-3 bg-light rounded-3 border">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 small">
                                            <div class="fw-bold text-dark">
                                                <i class="bi bi-person-circle text-huit me-1"></i>@q.Student.FullName
                                                @if (q.Lesson != null)
                                                {
                                                    <span class="badge bg-white text-muted border ms-1">@q.Lesson.Title</span>
                                                }
                                            </div>
                                            <span class="text-muted text-nowrap" style="font-size: 0.75rem;">@q.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                        </div>
                                        <p class="small mb-2 mt-2">@q.QuestionText</p>
                                        @if (!string.IsNullOrEmpty(q.AnswerText))
                                        {
                                            <div class="p-2 px-3 bg-white border-start border-3 border-warning rounded small">
                                                <strong class="text-orange"><i class="bi bi-patch-check-fill me-1"></i>Giảng viên @(q.AnsweredBy?.FullName ?? ""):</strong>
                                                <div class="mt-1">@q.AnswerText</div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis">
                                                <i class="bi bi-hourglass-split me-1"></i>Đang chờ giảng viên trả lời
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Tab 4: Đánh giá -->
                    <div class="tab-pane fade" id="tabReview" role="tabpanel">
                        @if (!Model.CanReview)
                        {
                            <div class="alert alert-warning border-0 mb-3">
                                <i class="bi bi-lock-fill me-1"></i>
                                Bạn cần đạt tiến độ học từ <strong>50% trở lên</strong> (hiện tại: <strong>@Model.Enrollment.ProgressPercent.ToString("0.#")%</strong>) mới có thể đánh giá khóa học trên HUIT Learning. Hãy tiếp tục học nhé!
                            </div>
                            <button type="button" class="btn btn-secondary" disabled style="min-height: 44px;">Đánh giá (Chưa đạt 50%)</button>
                        }
                        else
                        {
                            <form asp-area="Student" asp-controller="Reviews" asp-action="Save" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="CourseId" value="@Model.Course.Id" />
                                <input type="hidden" name="ReturnLessonId" value="@lesson.Id" />
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold">Mức độ hài lòng (1 - 5 sao)</label>
                                    <select name="Rating" class="form-select" style="max-width: 240px;">
                                        @for (int s = 5; s >= 1; s--)
                                        {
                                            <option value="@s" selected="@((Model.ExistingReview?.Rating ?? 5) == s)">@s sao ★</option>
                                        }
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold">Nhận xét của bạn</label>
                                    <textarea name="Comment" rows="3" class="form-control" placeholder="Chia sẻ cảm nhận thực tế của bạn về nội dung và giảng viên...">@Model.ExistingReview?.Comment</textarea>
                                </div>
                                <button type="submit" class="btn btn-orange px-4" style="min-height: 44px;">
                                    <i class="bi bi-star-fill me-1"></i>
                                    @(Model.ExistingReview == null ? "Gửi đánh giá" : "Cập nhật đánh giá")
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Curriculum Playlist Rail (Collapsible on mobile/tablet, Sticky on xl+) -->
    <div class="col-12 col-xl-4" id="coursePlaylistCard">
        <div class="hl-bento-card p-3 p-md-4 sticky-xl-top" style="top: 84px;" data-reveal="up">
            <div class="d-flex justify-content-between align-items-center gap-2">
                <div>
                    <span class="hl-eyebrow d-block">Lộ trình học</span>
                    <h2 class="h6 fw-bold mb-0 mt-1">
                        <i class="bi bi-list-check text-orange me-1"></i> Nội dung khóa học
                    </h2>
                </div>
                <button class="btn btn-sm btn-outline-huit d-xl-none" type="button"
                        data-bs-toggle="collapse" data-bs-target="#curriculumPlaylistCollapse"
                        aria-expanded="false" aria-controls="curriculumPlaylistCollapse" style="min-height: 40px;">
                    <i class="bi bi-chevron-expand me-1"></i> Thu gọn / Mở
                </button>
            </div>

            <div id="curriculumPlaylistCollapse" class="collapse d-xl-block mt-3">
                <div class="accordion accordion-flush border rounded-3 overflow-hidden" id="learnChaptersAccordion" style="max-height: 58vh; overflow-y: auto;">
                    @{
                        var orderedChapters = Model.Course.Chapters.OrderBy(c => c.SortOrder).ToList();
                    }
                    @for (int idx = 0; idx < orderedChapters.Count; idx++)
                    {
                        var ch = orderedChapters[idx];
                        bool hasCurrent = lesson != null && ch.Lessons.Any(l => l.Id == lesson.Id);
                        bool expandChapter = hasCurrent || (lesson == null && idx == 0);
                        var collapseId = $"chapterCollapse_{ch.Id}";

                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button @(expandChapter ? "" : "collapsed") py-2 px-3 bg-orange-soft fw-bold small"
                                        type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                        aria-expanded="@(expandChapter ? "true" : "false")" aria-controls="@collapseId">
                                    <span class="me-2">Chương @ch.SortOrder: @ch.Title</span>
                                </button>
                            </h3>
                            <div id="@collapseId" class="accordion-collapse collapse @(expandChapter ? "show" : "")">
                                <div class="list-group list-group-flush">
                                    @foreach (var item in ch.Lessons.OrderBy(l => l.SortOrder))
                                    {
                                        var done = Model.ProgressByLessonId.TryGetValue(item.Id, out var lp) && lp.IsCompleted;
                                        var active = lesson != null && item.Id == lesson.Id;
                                        <a asp-area="Student" asp-controller="Learn" asp-action="Index"
                                           asp-route-courseId="@Model.Course.Id" asp-route-lessonId="@item.Id"
                                           class="list-group-item list-group-item-action py-2 px-3 small d-flex justify-content-between align-items-center gap-2 @(active ? "bg-orange-soft fw-bold text-orange" : "")">
                                            <span class="text-truncate">
                                                <i class="bi @(item.LessonType == LessonType.Video ? "bi-play-circle" : "bi-file-text") me-1"></i>
                                                @item.Title
                                            </span>
                                            <span class="d-inline-flex align-items-center gap-2 flex-shrink-0">
                                                @if (item.LessonType == LessonType.Video && item.DurationSeconds > 0)
                                                {
                                                    <span class="text-muted text-nowrap" style="font-size: 0.72rem;">@TimeSpan.FromSeconds(item.DurationSeconds).ToString(@"mm\:ss")</span>
                                                }
                                                <i id="sidebarLessonIcon_@item.Id"
                                                   class="bi @(done ? "bi-check-circle-fill text-success" : "bi-circle text-muted") flex-shrink-0"></i>
                                            </span>
                                        </a>
                                    }
                                    @foreach (var cq in chapterQuizzes.Where(q => q.ChapterId == ch.Id))
                                    {
                                        <a asp-area="Student" asp-controller="Quiz" asp-action="Info" asp-route-id="@cq.Id"
                                           class="list-group-item list-group-item-action py-2 px-3 small text-huit fw-semibold">
                                            <i class="bi bi-ui-checks-grid me-1"></i> @cq.Title
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <hr class="my-3" />
            @if (finalExam != null)
            {
                <div class="d-grid gap-2">
                    <a id="finalExamBtn"
                       asp-area="Student" asp-controller="Quiz" asp-action="Info" asp-route-id="@finalExam.Id"
                       class="btn @(Model.CanTakeFinalExam ? "btn-orange" : "btn-outline-secondary disabled") d-inline-flex align-items-center justify-content-center"
                       style="min-height: 44px;">
                        <i class="bi @(Model.CanTakeFinalExam ? "bi-award-fill" : "bi-lock-fill") me-2"></i>
                        Bài thi cuối khóa
                    </a>
                    @if (!Model.CanTakeFinalExam)
                    {
                        <div id="finalExamHint" class="small text-muted text-center">
                            Hoàn thành 100% bài học để mở bài thi cuối khóa &amp; nhận chứng chỉ số HUIT Learning.
                        </div>
                    }
                </div>
            }

            @if (Model.ExistingCertificate != null)
            {
                <div class="mt-2 d-grid">
                    <a asp-area="Student" asp-controller="Certificates" asp-action="Index"
                       class="btn btn-success d-inline-flex align-items-center justify-content-center" style="min-height: 44px;">
                        <i class="bi bi-patch-check-fill me-2"></i> Xem chứng chỉ (@Model.ExistingCertificate.Code)
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('jumpToPlaylistBtn')?.addEventListener('click', function () {
            const collapseEl = document.getElementById('curriculumPlaylistCollapse');
            if (collapseEl && window.bootstrap) {
                bootstrap.Collapse.getOrCreateInstance(collapseEl).show();
            }
            document.getElementById('coursePlaylistCard')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    </script>
    @if (lesson != null && lesson.LessonType == LessonType.Video && lesson.VideoStatus == VideoUploadStatus.Ready)
    {
        <script>
            (function () {
                const lessonId = @lesson.Id;
                const durationSec = @lesson.DurationSeconds;
                const resumePos = @lastPosSec;
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                let isPlaying = false;
                let lastTickMs = null;
                let pendingDelta = 0;

                function sendHeartbeat(currentPos) {
                    const deltaToSend = Math.floor(pendingDelta);
                    pendingDelta = pendingDelta - deltaToSend;
                    if (deltaToSend <= 0 && currentPos <= 0) return;

                    fetch('@Url.Action("TrackProgress", "Learn", new { area = "Student" })', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({
                            lessonId: lessonId,
                            deltaWatchedSeconds: deltaToSend,
                            currentPositionSeconds: Math.round(currentPos || 0)
                        })
                    })
                    .then(r => r.ok ? r.json() : null)
                    .then(data => {
                        if (!data || !data.success) return;
                        document.getElementById('watchedSecondsSpan').textContent = data.watchedSeconds;
                        document.getElementById('lastPosSpan').textContent = data.lastPositionSeconds;
                        document.getElementById('courseProgressText').textContent = data.courseProgressPercent + '%';
                        document.getElementById('courseProgressBar').style.width = data.courseProgressPercent + '%';
                        document.getElementById('completedCountSpan').textContent = data.completedLessons;

                        if (data.lessonCompleted) {
                            const badge = document.getElementById('lessonCompletionBadge');
                            badge.className = 'badge bg-success px-3 py-2 align-self-start align-self-sm-center';
                            badge.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Đã hoàn thành';
                            const sideIcon = document.getElementById('sidebarLessonIcon_' + lessonId);
                            if (sideIcon) sideIcon.className = 'bi bi-check-circle-fill text-success flex-shrink-0';
                        }

                        if (data.finalExamUnlocked) {
                            const examBtn = document.getElementById('finalExamBtn');
                            if (examBtn) {
                                examBtn.classList.remove('btn-outline-secondary', 'disabled');
                                examBtn.classList.add('btn-orange');
                            }
                            const hint = document.getElementById('finalExamHint');
                            if (hint) hint.remove();
                        }
                    });
                }

                // Wall-clock tick: only counts elapsed seconds while video is actually playing (anti-skip)
                setInterval(function () {
                    if (isPlaying && lastTickMs !== null) {
                        const now = Date.now();
                        const elapsed = (now - lastTickMs) / 1000.0;
                        lastTickMs = now;
                        if (elapsed > 0 && elapsed < 10) {
                            pendingDelta += elapsed;
                        }
                    }
                }, 1000);

                // HTML5 local video player branch (mock mode)
                const localVideo = document.getElementById('localVideoPlayer');
                if (localVideo) {
                    localVideo.addEventListener('loadedmetadata', function () {
                        if (resumePos > 0 && resumePos < localVideo.duration) {
                            localVideo.currentTime = resumePos;
                        }
                    });
                    localVideo.addEventListener('play', function () {
                        isPlaying = true;
                        lastTickMs = Date.now();
                    });
                    localVideo.addEventListener('pause', function () {
                        isPlaying = false;
                        lastTickMs = null;
                        sendHeartbeat(localVideo.currentTime);
                    });
                    localVideo.addEventListener('ended', function () {
                        isPlaying = false;
                        lastTickMs = null;
                        sendHeartbeat(durationSec);
                    });
                    setInterval(function () {
                        if (isPlaying) sendHeartbeat(localVideo.currentTime);
                    }, 5000);
                }

                // YouTube IFrame Player API branch
                const ytDiv = document.getElementById('ytPlayer');
                if (ytDiv) {
                    let ytPlayer = null;
                    window.onYouTubeIframeAPIReady = function () {
                        ytPlayer = new YT.Player('ytPlayer', {
                            videoId: '@lesson.YoutubeVideoId',
                            playerVars: { start: resumePos, rel: 0, modestbranding: 1 },
                            events: {
                                onStateChange: function (event) {
                                    if (event.data === YT.PlayerState.PLAYING) {
                                        isPlaying = true;
                                        lastTickMs = Date.now();
                                    } else if (event.data === YT.PlayerState.PAUSED) {
                                        isPlaying = false;
                                        lastTickMs = null;
                                        sendHeartbeat(ytPlayer.getCurrentTime());
                                    } else if (event.data === YT.PlayerState.ENDED) {
                                        isPlaying = false;
                                        lastTickMs = null;
                                        sendHeartbeat(durationSec);
                                    }
                                }
                            }
                        });
                    };
                    setInterval(function () {
                        if (isPlaying && ytPlayer && typeof ytPlayer.getCurrentTime === 'function') {
                            sendHeartbeat(ytPlayer.getCurrentTime());
                        }
                    }, 5000);

                    const tag = document.createElement('script');
                    tag.src = 'https://www.youtube.com/iframe_api';
                    document.head.appendChild(tag);
                }
            })();
        </script>
    }
}
