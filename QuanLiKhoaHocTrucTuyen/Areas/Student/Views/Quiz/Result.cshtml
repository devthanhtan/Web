@model QuanLiKhoaHocTrucTuyen.Areas.Student.ViewModels.QuizResultViewModel
@{
    ViewData["Title"] = "Kết quả bài làm";
    ViewData["AreaTitle"] = "Kết quả kiểm tra";
}

<div class="app-card p-4 mb-4">
    <div class="row align-items-center g-3">
        <div class="col-md-8">
            <span class="badge @(Model.Attempt.IsPassed ? "bg-success" : "bg-danger") mb-2">
                @(Model.Attempt.IsPassed ? "ĐẠT YÊU CẦU" : "CHƯA ĐẠT")
            </span>
            <h1 class="h3 mb-1">@Model.Quiz.Title (Lần @Model.Attempt.AttemptNumber)</h1>
            <p class="text-muted small mb-0">
                Điểm của bạn: <strong class="text-orange fs-5">@Model.Attempt.ScorePercent.ToString("0.#")%</strong>
                (@Model.Attempt.CorrectCount / @Model.Attempt.TotalQuestions câu đúng · Điểm chuẩn: @Model.Quiz.PassingScorePercent%)
            </p>
        </div>
        <div class="col-md-4 text-md-end d-flex flex-wrap gap-2 justify-content-md-end">
            @if (Model.Certificate != null)
            {
                <a asp-area="Student" asp-controller="Certificates" asp-action="DownloadPdf" asp-route-id="@Model.Certificate.Id" class="btn btn-success">
                    <i class="bi bi-file-earmark-pdf-fill me-1"></i> Tải chứng chỉ PDF
                </a>
            }
            @if (Model.CanRetake)
            {
                <a asp-action="Info" asp-route-id="@Model.Quiz.Id" class="btn btn-orange">
                    <i class="bi bi-arrow-repeat me-1"></i> Thi lại
                </a>
            }
            <a asp-area="Student" asp-controller="Learn" asp-action="Index" asp-route-courseId="@Model.Quiz.CourseId" class="btn btn-outline-orange">
                Về bài học
            </a>
        </div>
    </div>
</div>

@if (Model.Certificate != null && Model.Quiz.IsFinalExam && Model.Attempt.IsPassed)
{
    <div class="alert alert-success border-0 shadow-sm mb-4">
        <h2 class="h6 fw-bold mb-1"><i class="bi bi-patch-check-fill me-1"></i> Đã cấp chứng chỉ điện tử!</h2>
        <p class="small mb-2">Mã chứng chỉ: <strong>@Model.Certificate.Code</strong></p>
        <a asp-area="" asp-controller="Certificate" asp-action="Verify" asp-route-code="@Model.Certificate.Code" class="btn btn-sm btn-light border">
            <i class="bi bi-qr-code me-1"></i> Xem trang xác thực công khai
        </a>
    </div>
}

<h2 class="h5 mb-3">Xem lại chi tiết từng câu hỏi</h2>
<div class="vstack gap-3">
    @for (int i = 0; i < Model.Questions.Count; i++)
    {
        var q = Model.Questions[i];
        Model.SelectedAnswers.TryGetValue(q.Id, out var chosen);
        bool isCorrect = string.Equals(chosen, q.CorrectOption, StringComparison.OrdinalIgnoreCase);

        <div class="app-card p-4 border-start border-4 @(isCorrect ? "border-success" : "border-danger")">
            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                <div class="fw-bold">Câu @(i + 1): @q.Content</div>
                <span class="badge @(isCorrect ? "bg-success" : "bg-danger")">@(isCorrect ? "Đúng" : "Sai")</span>
            </div>
            <div class="small mb-2">
                <div>A. @q.OptionA</div>
                <div>B. @q.OptionB</div>
                <div>C. @q.OptionC</div>
                <div>D. @q.OptionD</div>
            </div>
            <div class="small">
                Bạn chọn: <strong>@(string.IsNullOrEmpty(chosen) ? "Không trả lời" : chosen)</strong> ·
                Đáp án đúng: <strong class="text-success">@q.CorrectOption</strong>
            </div>
            @if (!string.IsNullOrEmpty(q.Explanation))
            {
                <div class="small text-muted mt-1"><em>Giải thích: @q.Explanation</em></div>
            }
        </div>
    }
</div>
