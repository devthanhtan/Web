@model QuanLiKhoaHocTrucTuyen.Areas.Student.ViewModels.QuizTakeViewModel
@{
    ViewData["Title"] = $"Làm bài: {Model.Quiz.Title}";
    ViewData["AreaTitle"] = "Làm bài kiểm tra";
}

<div class="app-card p-3 mb-4 sticky-top" style="top: 72px; z-index: 1010;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <div class="small text-muted">Lần làm thứ #@Model.Attempt.AttemptNumber · Điểm đạt: @Model.Quiz.PassingScorePercent%</div>
            <h1 class="h5 mb-0">@Model.Quiz.Title</h1>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="px-3 py-2 rounded bg-orange-soft border border-warning-subtle">
                <i class="bi bi-alarm text-orange me-1"></i>
                Thời gian còn lại: <strong id="countdownDisplay" class="fs-5 text-orange">--:--</strong>
            </div>
        </div>
    </div>
</div>

<form id="quizForm" asp-action="Submit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="attemptId" value="@Model.Attempt.Id" />

    <div class="vstack gap-3 mb-4">
        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            <div class="app-card p-4">
                <div class="fw-bold mb-3">Câu @(i + 1): @q.Content</div>
                <div class="vstack gap-2">
                    @foreach (var opt in new[] { ("A", q.OptionA), ("B", q.OptionB), ("C", q.OptionC), ("D", q.OptionD) })
                    {
                        <label class="border rounded p-2 px-3 d-flex align-items-center gap-2 cursor-pointer">
                            <input class="form-check-input mt-0" type="radio" name="answers[@q.Id]" value="@opt.Item1" />
                            <span><strong>@opt.Item1.</strong> @opt.Item2</span>
                        </label>
                    }
                </div>
            </div>
        }
    </div>

    <div class="text-end">
        <button type="submit" class="btn btn-orange btn-lg px-5">
            <i class="bi bi-send-check me-1"></i> Nộp bài ngay
        </button>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            let remaining = @Model.RemainingSeconds;
            const display = document.getElementById('countdownDisplay');
            const form = document.getElementById('quizForm');
            let submitted = false;

            function render() {
                const m = Math.floor(remaining / 60);
                const s = remaining % 60;
                display.textContent = String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
                if (remaining <= 60) {
                    display.classList.remove('text-orange');
                    display.classList.add('text-danger');
                }
            }

            render();
            const timer = setInterval(function () {
                remaining--;
                if (remaining <= 0) {
                    remaining = 0;
                    render();
                    clearInterval(timer);
                    if (!submitted) {
                        submitted = true;
                        form.submit();
                    }
                    return;
                }
                render();
            }, 1000);

            form.addEventListener('submit', function () {
                submitted = true;
                clearInterval(timer);
            });
        })();
    </script>
}
