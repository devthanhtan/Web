@model QuanLiKhoaHocTrucTuyen.Areas.Student.ViewModels.QuizInfoViewModel
@{
    ViewData["Title"] = Model.Quiz.Title;
    ViewData["AreaTitle"] = "Kiểm tra & Thi";
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="app-card p-4">
            <span class="badge @(Model.Quiz.IsFinalExam ? "bg-danger-subtle text-danger" : "badge-orange") mb-2">
                @(Model.Quiz.IsFinalExam ? "Bài thi cuối khóa" : "Kiểm tra chương")
            </span>
            <h1 class="h3 mb-2">@Model.Quiz.Title</h1>
            <p class="text-muted small mb-4">@Model.Quiz.Description</p>

            <div class="row g-3 mb-4">
                <div class="col-4">
                    <div class="p-3 bg-orange-soft rounded text-center">
                        <div class="fw-bold fs-5 text-orange">@Model.Quiz.DurationMinutes phút</div>
                        <div class="small text-muted">Thời gian</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-3 bg-orange-soft rounded text-center">
                        <div class="fw-bold fs-5 text-orange">@Model.Quiz.PassingScorePercent%</div>
                        <div class="small text-muted">Điểm chuẩn đạt</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-3 bg-orange-soft rounded text-center">
                        <div class="fw-bold fs-5 text-orange">@Model.Quiz.QuizQuestions.Count</div>
                        <div class="small text-muted">Số câu hỏi</div>
                    </div>
                </div>
            </div>

            @if (!Model.Eligibility.CanStart)
            {
                <div class="alert alert-warning border-0 mb-3">
                    <i class="bi bi-lock-fill me-1"></i> @Model.Eligibility.Reason
                </div>
            }
            else
            {
                <form asp-action="Start" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Quiz.Id" />
                    <button type="submit" class="btn btn-orange px-4 py-2">
                        <i class="bi bi-play-fill me-1"></i> Bắt đầu làm bài ngay
                    </button>
                </form>
            }

            <div class="mt-3">
                <a asp-area="Student" asp-controller="Learn" asp-action="Index" asp-route-courseId="@Model.Quiz.CourseId" class="btn btn-sm btn-light border">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại giao diện học
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="app-card p-4">
            <h2 class="h6 fw-bold mb-3">Lịch sử các lần làm bài (@Model.PastAttempts.Count)</h2>
            @if (!Model.PastAttempts.Any())
            {
                <p class="small text-muted mb-0">Bạn chưa thực hiện bài kiểm tra này.</p>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var att in Model.PastAttempts)
                    {
                        <a asp-action="Result" asp-route-attemptId="@att.Id" class="list-group-item list-group-item-action px-0 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold small">Lần @att.AttemptNumber · @att.ScorePercent.ToString("0.#")% (@att.CorrectCount/@att.TotalQuestions)</div>
                                <div class="text-muted" style="font-size:0.75rem;">@att.SubmittedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            <span class="badge @(att.IsPassed ? "bg-success" : "bg-danger")">@(att.IsPassed ? "Đạt" : "Chưa đạt")</span>
                        </a>
                    }
                </div>
            }

            @if (Model.Certificate != null)
            {
                <hr />
                <a asp-area="Student" asp-controller="Certificates" asp-action="DownloadPdf" asp-route-id="@Model.Certificate.Id" class="btn btn-success w-100 btn-sm">
                    <i class="bi bi-file-earmark-pdf me-1"></i> Tải chứng chỉ PDF (@Model.Certificate.Code)
                </a>
            }
        </div>
    </div>
</div>
