        <div class="row align-items-center g-4">
            <div class="col-12 col-lg-8">
                <span class="badge bg-white bg-opacity-10 text-white border border-white border-opacity-25 rounded-pill px-3 py-2 mb-3">
                    <i class="bi bi-easel2-fill text-orange me-1" aria-hidden="true"></i> Cộng đồng Giảng viên &amp; Chuyên gia
                </span>
                <h2 class="h3 fw-bold text-white mb-2">Lan tỏa tri thức cùng hệ sinh thái HUIT Learning</h2>
                <p class="text-white-50 mb-0">
                    Xây dựng khóa học trực tuyến chuyên nghiệp với trình biên tập đề cương trực quan, ngân hàng câu hỏi trắc nghiệm và bảng theo dõi doanh thu minh bạch.
                </p>
            </div>
            <div class="col-12 col-lg-4 text-lg-end">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-area="Student" asp-controller="InstructorApplication" asp-action="Index" class="btn btn-orange btn-lg rounded-pill px-4 fs-6">
                        <i class="bi bi-send-check me-1" aria-hidden="true"></i> Đăng ký làm Giảng viên
                    </a>
