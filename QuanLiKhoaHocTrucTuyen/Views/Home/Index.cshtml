@model QuanLiKhoaHocTrucTuyen.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Trang chủ - Nền tảng học tập số thế hệ mới";
}

<style>
    .hl-hero-shell {
        border-radius: 1.75rem;
        background:
            radial-gradient(circle at 8% 12%, rgba(29, 78, 216, 0.08), transparent 46%),
            radial-gradient(circle at 92% 88%, rgba(249, 115, 22, 0.1), transparent 48%),
            linear-gradient(160deg, #ffffff 0%, #f8fafc 55%, #eff6ff 100%);
        border: 1px solid rgba(15, 23, 42, 0.08);
        position: relative;
        overflow: hidden;
    }

    .hl-hero-search {
        background: #ffffff;
        border: 1px solid rgba(15, 23, 42, 0.1);
        border-radius: 999px;
        padding: 0.35rem;
        box-shadow: 0 12px 32px -12px rgba(15, 23, 42, 0.12);
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .hl-hero-search:focus-within {
        border-color: rgba(29, 78, 216, 0.45);
        box-shadow: 0 16px 36px -12px rgba(29, 78, 216, 0.2);
    }

    .hl-hero-stage {
        position: relative;
        height: 260px;
        border-radius: 1.5rem;
        background:
            radial-gradient(circle at 50% 45%, rgba(56, 189, 248, 0.22), rgba(15, 23, 42, 0.94) 72%),
            linear-gradient(145deg, #0b162c 0%, #102447 55%, #0f172a 100%);
        border: 1px solid rgba(255, 255, 255, 0.14);
        box-shadow: 0 24px 48px -18px rgba(11, 22, 44, 0.45);
        overflow: hidden;
    }

    @@media (min-width: 768px) {
        .hl-hero-stage {
            height: 340px;
        }
    }

    @@media (min-width: 992px) {
        .hl-hero-stage {
            height: 420px;
        }
    }

    .hl-hero-stage canvas {
        position: relative;
        z-index: 1;
    }

    .hl-hero-fallback-orbit {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        z-index: 0;
        opacity: 0.4;
    }

    .hl-hero-chip {
        position: absolute;
        z-index: 2;
        pointer-events: none;
        border-radius: 999px;
        padding: 0.45rem 0.9rem;
        font-size: 0.78rem;
        font-weight: 600;
        color: #0f172a;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.85);
        box-shadow: 0 12px 24px -8px rgba(15, 23, 42, 0.28);
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        white-space: nowrap;
    }

    .hl-kpi-value {
        font-family: 'JetBrains Mono', monospace;
        letter-spacing: -0.03em;
    }

    .hl-bento-dark {
        background:
            radial-gradient(circle at 85% 18%, rgba(249, 115, 22, 0.24), transparent 45%),
            radial-gradient(circle at 12% 88%, rgba(56, 189, 248, 0.18), transparent 48%),
            linear-gradient(145deg, #0b162c 0%, #102a5c 58%, #0f172a 100%);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 1.5rem;
    }

    .hl-step-badge {
        font-family: 'JetBrains Mono', monospace;
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.95rem;
        background: linear-gradient(135deg, #1d4ed8 0%, #f97316 100%);
        color: #ffffff;
        box-shadow: 0 10px 20px -6px rgba(29, 78, 216, 0.35);
    }

    .hl-cat-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.05rem;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid rgba(15, 23, 42, 0.1);
        color: #0f172a;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

    .hl-cat-pill:hover {
        border-color: rgba(29, 78, 216, 0.35);
        color: #1d4ed8;
        background: #eff6ff;
    }
</style>

<!-- EDITORIAL HERO & 3D ASTROLABE STAGE -->
<section class="hero-huit-3d hl-hero-shell p-3 p-sm-4 p-lg-5 mb-5">
    <div class="row align-items-center g-4 g-lg-5">
        <div class="col-12 col-lg-7" data-reveal="up">
            <div class="d-inline-flex align-items-center gap-2 badge-huit rounded-pill px-3 py-2 mb-3 small fw-semibold">
                <i class="bi bi-stars text-orange" aria-hidden="true"></i>
                <span>HUIT Learning · Hệ sinh thái học tập số chuẩn đại học</span>
            </div>

            <h1 class="display-5 fw-bold mb-3 lh-sm tracking-tight">
                Làm chủ công nghệ &amp; kỹ năng số cùng <span class="text-gradient-huit">HUIT Learning</span>
            </h1>

            <p class="lead text-muted mb-4 fs-6 fs-md-5" style="max-width: 600px;">
                Học trực tuyến qua bài giảng video chuẩn HD, thi trắc nghiệm đếm ngược thông minh, đồng bộ tiến độ từng giây và nhận chứng chỉ điện tử PDF xác thực mã QR tức thì.
            </p>

            <!-- Pill Search Bar -->
            <form method="get" asp-area="" asp-controller="Courses" asp-action="Index" class="mb-4" role="search" aria-label="Tìm kiếm nhanh khóa học">
                <div class="hl-hero-search d-flex align-items-center gap-2">
                    <div class="input-group flex-grow-1">
                        <span class="input-group-text bg-transparent border-0 text-muted ps-3">
                            <i class="bi bi-search" aria-hidden="true"></i>
                        </span>
                        <input type="text"
                               name="keyword"
                               class="form-control border-0 shadow-none bg-transparent"
                               placeholder="Tìm ASP.NET Core, SQL, AI, UI/UX..."
                               aria-label="Từ khóa khóa học" />
                    </div>
                    <button type="submit" class="btn btn-orange rounded-pill px-3 px-sm-4 py-2 fw-semibold flex-shrink-0">
                        <span class="d-none d-sm-inline">Tìm khóa học</span>
                        <i class="bi bi-arrow-right d-sm-none" aria-hidden="true"></i>
                    </button>
                </div>
            </form>

            <!-- Dual Primary CTAs -->
            <div class="d-flex flex-wrap align-items-center gap-2 gap-sm-3 mb-4">
                <a asp-area="" asp-controller="Courses" asp-action="Index" class="btn btn-huit btn-lg rounded-pill px-4 fs-6">
                    <i class="bi bi-compass me-1" aria-hidden="true"></i> Khám phá thư viện
                </a>
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-orange btn-lg rounded-pill px-4 fs-6">
                        <i class="bi bi-person-plus me-1" aria-hidden="true"></i> Tạo tài khoản miễn phí
                    </a>
                }
                else
                {
                    <a asp-area="Student" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-orange btn-lg rounded-pill px-4 fs-6">
                        <i class="bi bi-play-circle me-1" aria-hidden="true"></i> Vào góc học tập
                    </a>
                }
                <a asp-area="" asp-controller="Certificate" asp-action="Verify" class="btn btn-link text-decoration-none fw-semibold text-huit px-2">
                    <i class="bi bi-qr-code-scan text-orange me-1" aria-hidden="true"></i> Tra cứu QR
                </a>
            </div>

            <!-- Inline KPI Counters -->
            <div class="row row-cols-2 row-cols-sm-4 g-3 pt-3 border-top">
                <div class="col">
                    <div class="hl-kpi-value fs-4 fw-bold text-dark">
                        <span data-count-to="@Model.TotalCourses">@Model.TotalCourses</span>+
                    </div>
                    <div class="small text-muted">Khóa học kiểm duyệt</div>
                </div>
                <div class="col">
                    <div class="hl-kpi-value fs-4 fw-bold text-dark">
                        <span data-count-to="@Model.TotalStudents">@Model.TotalStudents</span>+
                    </div>
                    <div class="small text-muted">Học viên tích cực</div>
                </div>
                <div class="col">
                    <div class="hl-kpi-value fs-4 fw-bold text-dark">
                        <span data-count-to="@Model.TotalInstructors">@Model.TotalInstructors</span>+
                    </div>
                    <div class="small text-muted">Giảng viên chuyên gia</div>
                </div>
                <div class="col">
                    <div class="hl-kpi-value fs-4 fw-bold text-orange">
                        <span data-count-to="100">100</span>%
                    </div>
                    <div class="small text-muted">Chứng chỉ xác thực QR</div>
                </div>
            </div>
        </div>

        <!-- 3D Astrolabe / Knowledge Core Stage -->
        <div class="col-12 col-lg-5" data-reveal="scale">
            <div class="hl-hero-stage" data-parallax="0.08">
                <div class="hl-hero-fallback-orbit" aria-hidden="true">
                    <svg width="260" height="260" viewBox="0 0 260 260" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="130" cy="130" r="106" stroke="#38bdf8" stroke-width="1.2" stroke-dasharray="6 6" />
                        <circle cx="130" cy="130" r="74" stroke="#f97316" stroke-width="1.5" />
                        <polygon points="130,68 184,99 184,161 130,192 76,161 76,99" stroke="#60a5fa" stroke-width="1.75" fill="rgba(29,78,216,0.16)" />
                    </svg>
                </div>

                <canvas id="huit-hero-3d-canvas" class="w-100 h-100 d-block" aria-hidden="true"></canvas>

                <div class="hl-hero-chip glass-card" style="top: 16px; left: 16px;">
                    <i class="bi bi-cpu-fill text-orange" aria-hidden="true"></i>
                    <span>Knowledge Core 3D</span>
                </div>

                <div class="hl-hero-chip glass-card d-none d-sm-inline-flex" style="top: 16px; right: 16px;">
                    <i class="bi bi-lightning-charge-fill text-huit" aria-hidden="true"></i>
                    <span>Tiến độ thời gian thực</span>
                </div>

                <div class="hl-hero-chip glass-card" style="bottom: 16px; left: 16px;">
                    <i class="bi bi-qr-code-scan text-success" aria-hidden="true"></i>
                    <span>Chứng chỉ PDF + QR</span>
                </div>

                <div class="hl-hero-chip glass-card d-none d-sm-inline-flex" style="bottom: 16px; right: 16px;">
                    <i class="bi bi-patch-check-fill text-orange" aria-hidden="true"></i>
                    <span>Chuẩn HUIT Learning</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CATEGORY DISCOVERY STRIP -->
<section class="hl-section mb-5" aria-labelledby="home-categories-heading">
    <div class="d-flex flex-wrap justify-content-between align-items-end mb-3 gap-2" data-reveal="up">
        <div>
            <span class="hl-eyebrow text-orange">Lĩnh vực đào tạo</span>
            <h2 id="home-categories-heading" class="h3 fw-bold mb-1 mt-1">Khám phá theo chuyên ngành</h2>
            <p class="text-muted small mb-0">Lựa chọn lộ trình học tập phù hợp với mục tiêu nghề nghiệp của bạn</p>
        </div>
        <a asp-area="" asp-controller="Courses" asp-action="Index" class="btn btn-sm btn-outline-huit rounded-pill px-3">
            Xem tất cả <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
        </a>
    </div>

    <!-- Mobile & Tablet Snap-Scroll Pills -->
    <div class="hl-pill-scroll d-flex d-lg-none gap-2 pb-2" data-reveal="up">
        <a asp-area="" asp-controller="Courses" asp-action="Index" class="hl-cat-pill">
            <i class="bi bi-grid-fill text-orange" aria-hidden="true"></i>
            <span>Tất cả khóa học</span>
        </a>
        @foreach (var cat in Model.Categories)
        {
            <a asp-area=""
               asp-controller="Courses"
               asp-action="Index"
               asp-route-categoryId="@cat.Id"
               class="hl-cat-pill">
                <i class="bi @cat.IconClass text-huit" aria-hidden="true"></i>
                <span>@cat.Name</span>
            </a>
        }
    </div>

    <!-- Desktop 4-Column Bento Category Grid -->
    <div class="row row-cols-2 row-cols-md-4 g-3 d-none d-lg-flex" data-stagger-group>
        @foreach (var cat in Model.Categories)
        {
            <div class="col" data-reveal="up">
                <a asp-area=""
                   asp-controller="Courses"
                   asp-action="Index"
                   asp-route-categoryId="@cat.Id"
                   data-tilt-3d
                   class="hl-bento-card app-card app-card-hover p-3 d-flex align-items-center gap-3 text-decoration-none h-100">
                    <div class="stat-icon flex-shrink-0">
                        <i class="bi @cat.IconClass" aria-hidden="true"></i>
                    </div>
                    <div class="min-w-0 flex-grow-1 overflow-hidden">
                        <div class="fw-bold text-dark text-truncate" title="@cat.Name">@cat.Name</div>
                        <div class="small text-muted hl-line-clamp-2 mt-1" title="@cat.Description">@cat.Description</div>
                    </div>
                </a>
            </div>
        }
    </div>
</section>

<!-- FEATURED COURSES SHOWCASE -->
<section class="hl-section mb-5" aria-labelledby="home-featured-heading">
    <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-2" data-reveal="up">
        <div>
            <span class="hl-eyebrow text-orange">Chương trình nổi bật</span>
            <h2 id="home-featured-heading" class="h3 fw-bold mb-1 mt-1">Khóa học tiêu biểu tại HUIT Learning</h2>
            <p class="text-muted small mb-0">Nội dung kiểm định chặt chẽ, thực hành sát thực tế và đánh giá cao từ cộng đồng</p>
        </div>
        <a asp-area="" asp-controller="Courses" asp-action="Index" class="btn btn-sm btn-orange rounded-pill px-3">
            <i class="bi bi-grid me-1" aria-hidden="true"></i> Toàn bộ thư viện
        </a>
    </div>

    @if (!Model.FeaturedCourses.Any())
    {
        <div class="hl-bento-card app-card p-5 text-center text-muted" data-reveal="fade">
            <div class="stat-icon mx-auto mb-3"><i class="bi bi-journal-bookmark" aria-hidden="true"></i></div>
            <p class="mb-0">Hiện chưa có khóa học công khai nào. Vui lòng quay lại sau.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4" data-stagger-group>
            @foreach (var course in Model.FeaturedCourses)
            {
                <partial name="_CourseCardPartial" model="course" />
            }
        </div>
    }
</section>

<!-- ASYMMETRIC BENTO VALUE GRID -->
<section class="hl-section mb-5" aria-labelledby="home-bento-heading">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-2" data-reveal="up">
        <div>
            <span class="hl-eyebrow text-orange">Ưu thế công nghệ giáo dục</span>
            <h2 id="home-bento-heading" class="h3 fw-bold mb-1 mt-1">Trải nghiệm học tập chuẩn HUIT Learning</h2>
        </div>
        <p class="text-muted small mb-0" style="max-width: 440px;">
            Thiết kế tối ưu cho cả máy tính, máy tính bảng và điện thoại để bạn học mọi lúc mà không gián đoạn mạch kiến thức.
        </p>
    </div>

    <div class="row g-3 g-lg-4" data-stagger-group>
        <!-- Large Editorial Feature Card -->
        <div class="col-12 col-lg-5" data-reveal="up">
            <div class="hl-bento-dark p-4 p-md-5 h-100 d-flex flex-column justify-content-between" data-tilt-3d>
                <div>
                    <span class="badge bg-white text-dark rounded-pill px-3 py-2 mb-3 fw-semibold">
                        <i class="bi bi-mortarboard-fill text-orange me-1" aria-hidden="true"></i> Chuẩn Đại học Số HUIT
                    </span>
                    <h3 class="h4 fw-bold text-white mb-3 lh-base">
                        Học tập liền mạch từ bài giảng HD đến chứng chỉ định danh mã QR
                    </h3>
                    <p class="text-white-50 mb-4 small lh-lg">
                        Mỗi khóa học đều được thẩm định học thuật, tích hợp phòng học Cinema 16:9, tài liệu mã nguồn thực hành và hệ thống kiểm tra năng lực chấm điểm tức thì.
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-area="" asp-controller="Courses" asp-action="Index" class="btn btn-orange rounded-pill px-4">
                        Bắt đầu học ngay <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                    </a>
                    <a asp-area="" asp-controller="Certificate" asp-action="Verify" class="btn btn-outline-light rounded-pill px-3">
                        Xác thực QR
                    </a>
                </div>
            </div>
        </div>

        <!-- 3 Compact Bento Feature Cards -->
        <div class="col-12 col-lg-7">
            <div class="row g-3 g-lg-4 h-100">
                <div class="col-12 col-sm-6" data-reveal="up">
                    <div class="hl-bento-card app-card app-card-hover p-4 h-100" data-tilt-3d>
                        <div class="stat-icon mb-3"><i class="bi bi-play-btn-fill" aria-hidden="true"></i></div>
                        <h3 class="h6 fw-bold mb-2">Đồng bộ tiến độ từng giây</h3>
                        <p class="small text-muted mb-0">
                            Tự động lưu mốc thời gian xem video và mở khóa bài học tiếp theo chính xác trên mọi thiết bị.
                        </p>
                    </div>
                </div>
                <div class="col-12 col-sm-6" data-reveal="up">
                    <div class="hl-bento-card app-card app-card-hover p-4 h-100" data-tilt-3d>
                        <div class="stat-icon mb-3"><i class="bi bi-stopwatch-fill" aria-hidden="true"></i></div>
                        <h3 class="h6 fw-bold mb-2">Phòng thi đếm ngược thông minh</h3>
                        <p class="small text-muted mb-0">
                            Làm bài trắc nghiệm trực tuyến có giới hạn thời gian, chấm điểm tự động và xem phân tích đáp án chi tiết.
                        </p>
                    </div>
                </div>
                <div class="col-12" data-reveal="up">
                    <div class="hl-bento-card app-card app-card-hover p-4 h-100 d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-3" data-tilt-3d>
                        <div class="stat-icon flex-shrink-0"><i class="bi bi-file-earmark-check-fill" aria-hidden="true"></i></div>
                        <div>
                            <h3 class="h6 fw-bold mb-1">Chứng chỉ điện tử PDF + Mã QR &amp; Hỏi đáp Giảng viên</h3>
                            <p class="small text-muted mb-0">
                                Trao đổi Q&amp;A trực tiếp dưới từng bài giảng và nhận chứng chỉ PDF định danh hỗ trợ nhà tuyển dụng quét mã QR xác thực 24/7.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 3-STEP LEARNING ROADMAP -->
<section class="hl-section mb-5" aria-labelledby="home-roadmap-heading">
    <div class="mb-4" data-reveal="up">
        <span class="hl-eyebrow text-orange">Lộ trình 3 bước</span>
        <h2 id="home-roadmap-heading" class="h3 fw-bold mb-1 mt-1">Chinh phục kỹ năng mới theo quy trình khép kín</h2>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4" data-stagger-group>
        <div class="col" data-reveal="up">
            <div class="hl-bento-card app-card p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="hl-step-badge">01</span>
                    <i class="bi bi-search-heart fs-3 text-huit opacity-50" aria-hidden="true"></i>
                </div>
                <h3 class="h6 fw-bold mb-2">Chọn khóa học &amp; Học thử miễn phí</h3>
                <p class="small text-muted mb-0">
                    Xem đề cương chi tiết, trải nghiệm bài giảng học thử ngay trên trình duyệt và đăng ký lộ trình phù hợp.
                </p>
            </div>
        </div>
        <div class="col" data-reveal="up">
            <div class="hl-bento-card app-card p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="hl-step-badge">02</span>
                    <i class="bi bi-laptop fs-3 text-huit opacity-50" aria-hidden="true"></i>
                </div>
                <h3 class="h6 fw-bold mb-2">Học chủ động &amp; Kiểm tra năng lực</h3>
                <p class="small text-muted mb-0">
                    Theo dõi bài giảng HD, tải tài liệu thực hành, hỏi đáp cùng giảng viên và hoàn thành bài thi cuối khóa.
                </p>
            </div>
        </div>
        <div class="col" data-reveal="up">
            <div class="hl-bento-card app-card p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="hl-step-badge">03</span>
                    <i class="bi bi-award fs-3 text-orange opacity-75" aria-hidden="true"></i>
                </div>
                <h3 class="h6 fw-bold mb-2">Nhận chứng chỉ số HUIT Learning</h3>
                <p class="small text-muted mb-0">
                    Tải chứng chỉ PDF sắc nét tích hợp mã QR xác thực trực tuyến để bổ sung vào hồ sơ năng lực và CV.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- DARK-NAVY INSTRUCTOR CTA BANNER -->
