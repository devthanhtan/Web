@{
    var rawTitle = ViewData["Title"]?.ToString();
    var pageTitle = string.IsNullOrWhiteSpace(rawTitle)
        ? "HUIT Learning"
        : (rawTitle.Contains("HUIT Learning", StringComparison.OrdinalIgnoreCase)
            ? rawTitle
            : $"{rawTitle} - HUIT Learning");
    var areaTitle = ViewData["AreaTitle"]?.ToString() ?? "Không gian học tập";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="view-transition" content="same-origin" />
    <title>@pageTitle</title>
    <script>
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.classList.add('js-motion-ready');
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="hl-skip-link" href="#dashboard-main-content">Chuyển đến nội dung chính</a>

    <div class="hl-scroll-progress" aria-hidden="true">
        <div class="hl-scroll-progress__bar"></div>
    </div>

    <header class="hl-header-wrap">
        <nav class="navbar app-navbar hl-floating-nav py-2 px-2 px-md-3" aria-label="Thanh điều hướng cổng thông tin">
            <div class="d-flex align-items-center gap-2 min-w-0">
                <button class="hl-nav-toggle d-lg-none"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#dashboardMobileSidebar"
                        aria-controls="dashboardMobileSidebar"
                        aria-label="Mở menu điều hướng">
                    <i class="bi bi-list fs-4" aria-hidden="true"></i>
                </button>
                <a class="navbar-brand brand-mark mb-0 me-0" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon"><i class="bi bi-mortarboard-fill" aria-hidden="true"></i></span>
                    <span>HUIT <span class="text-orange">Learning</span></span>
                </a>
                <span class="badge badge-huit rounded-pill d-none d-md-inline-flex align-items-center gap-1 ms-1 px-3 py-1">
                    <i class="bi bi-grid-1x2-fill small" aria-hidden="true"></i>
                    @areaTitle
                </span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a class="btn btn-sm btn-outline-huit d-none d-md-inline-flex align-items-center gap-1 rounded-pill px-3" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-globe2" aria-hidden="true"></i> Trang công khai
                </a>
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>

    <div class="dashboard-shell">
        <aside class="dashboard-sidebar d-none d-lg-block p-3" aria-label="Menu điều hướng bên">
            <partial name="_DashboardSidebarPartial" />
        </aside>

        <div class="offcanvas offcanvas-start" tabindex="-1" id="dashboardMobileSidebar" aria-labelledby="dashboardMobileSidebarLabel" style="width: 292px; max-width: 86vw;">
            <div class="offcanvas-header border-bottom bg-light">
                <div class="d-flex align-items-center gap-2" id="dashboardMobileSidebarLabel">
                    <span class="brand-mark">
                        <span class="brand-icon" style="width: 34px; height: 34px; font-size: 0.95rem;"><i class="bi bi-mortarboard-fill" aria-hidden="true"></i></span>
                        <span class="fs-6">HUIT <span class="text-orange">Learning</span></span>
                    </span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
            </div>
            <div class="offcanvas-body p-3 d-flex flex-column justify-content-between">
                <div>
                    <partial name="_DashboardSidebarPartial" />
                </div>
                <div class="pt-3 mt-3 border-top">
                    <a class="btn btn-outline-huit btn-sm w-100 d-inline-flex align-items-center justify-content-center gap-2 rounded-pill py-2" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-globe2" aria-hidden="true"></i> Về trang chủ HUIT Learning
                    </a>
                </div>
            </div>
        </div>

        <main id="dashboard-main-content" class="dashboard-main" role="main">
            <nav class="dashboard-breadcrumb-bar" aria-label="Vị trí trang">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="text-muted">HUIT Learning</a>
                    </li>
                    <li class="breadcrumb-item text-muted">@areaTitle</li>
                    @if (!string.IsNullOrWhiteSpace(rawTitle))
                    {
                        <li class="breadcrumb-item active fw-semibold text-ink" aria-current="page">@rawTitle</li>
                    }
                </ol>
                <span class="badge badge-orange rounded-pill px-3 py-1 d-md-none">@areaTitle</span>
            </nav>

            <partial name="_AlertsPartial" />
            @RenderBody()
        </main>
    </div>

    <button type="button" class="hl-back-to-top" aria-label="Cuộn lên đầu trang" title="Lên đầu trang">
        <svg class="hl-back-to-top__ring" viewBox="0 0 48 48" aria-hidden="true">
            <circle class="hl-back-to-top__track" cx="24" cy="24" r="21"></circle>
            <circle class="hl-back-to-top__fill" cx="24" cy="24" r="21"></circle>
        </svg>
        <i class="bi bi-arrow-up" aria-hidden="true"></i>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/lenis@1.1.18/dist/lenis.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
    <script defer src="~/js/site.js" asp-append-version="true"></script>
    <script type="module" src="~/js/huit-3d-hero.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
