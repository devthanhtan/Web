@using Microsoft.AspNetCore.Identity
@using QuanLiKhoaHocTrucTuyen.Data
@using QuanLiKhoaHocTrucTuyen.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser?.FullName ?? User.Identity?.Name ?? "Tài khoản";
    var avatarInitial = string.IsNullOrWhiteSpace(displayName) ? "U" : displayName[0].ToString().ToUpper();

    <div class="d-flex align-items-center justify-content-between justify-content-lg-end gap-2">
        <div class="d-flex align-items-center gap-2">
            @await Component.InvokeAsync("CartCount")
            @await Component.InvokeAsync("UnreadNotifications")
        </div>

        <div class="dropdown">
            <button class="btn btn-light border rounded-pill d-flex align-items-center gap-2 py-1 px-2 pe-2 pe-sm-3"
                    style="min-height: 42px;"
                    type="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    aria-label="Menu tài khoản">
                @if (!string.IsNullOrEmpty(currentUser?.AvatarUrl))
                {
                    <img src="@currentUser.AvatarUrl" alt="@displayName" onerror="this.style.display='none';" class="avatar-circle" />
                }
                else
                {
                    <span class="avatar-circle">@avatarInitial</span>
                }
                <span class="d-none d-md-inline small fw-semibold text-ink text-truncate" style="max-width: 135px;">@displayName</span>
                <i class="bi bi-chevron-down small text-muted" aria-hidden="true"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4 mt-2 p-1">
                <li class="px-3 py-2 border-bottom bg-light rounded-top-3 mb-1">
                    <div class="fw-bold small text-ink">@displayName</div>
                    <div class="text-muted" style="font-size: 0.76rem;">@currentUser?.Email</div>
                </li>
                @if (User.IsInRole(AppRoles.Admin))
                {
                    <li>
                        <a class="dropdown-item fw-semibold text-huit py-2 rounded-3" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-shield-lock me-2" aria-hidden="true"></i>Quản trị HUIT Learning
                        </a>
                    </li>
                }
                @if (User.IsInRole(AppRoles.Instructor))
                {
                    <li>
                        <a class="dropdown-item fw-semibold py-2 rounded-3" asp-area="Instructor" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-easel2 me-2 text-orange" aria-hidden="true"></i>Studio Giảng viên
                        </a>
                    </li>
                }
                <li>
                    <a class="dropdown-item py-2 rounded-3" asp-area="Student" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-journal-bookmark me-2 text-huit" aria-hidden="true"></i>Khóa học của tôi
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2 rounded-3" asp-area="Student" asp-controller="Profile" asp-action="Index">
                        <i class="bi bi-person-gear me-2 text-huit" aria-hidden="true"></i>Hồ sơ cá nhân
                    </a>
                </li>
                @if (!User.IsInRole(AppRoles.Instructor) && !User.IsInRole(AppRoles.Admin))
                {
                    <li>
                        <a class="dropdown-item py-2 rounded-3" asp-area="Student" asp-controller="InstructorApplication" asp-action="Index">
                            <i class="bi bi-award me-2 text-orange" aria-hidden="true"></i>Đăng ký làm Giảng viên
                        </a>
                    </li>
                }
                <li><hr class="dropdown-divider my-1" /></li>
                <li>
                    <form class="m-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                        <button type="submit" class="dropdown-item text-danger py-2 rounded-3">
                            <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Đăng xuất
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
}
else
{
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-sm btn-outline-huit rounded-pill px-3 py-2 flex-fill flex-lg-grow-0 text-center" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
        <a class="btn btn-sm btn-orange rounded-pill px-3 py-2 flex-fill flex-lg-grow-0 text-center" asp-area="Identity" asp-page="/Account/Register">Đăng ký</a>
    </div>
}
