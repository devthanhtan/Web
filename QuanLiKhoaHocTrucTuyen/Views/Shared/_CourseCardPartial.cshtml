@model QuanLiKhoaHocTrucTuyen.ViewModels.CourseCardViewModel
<div class="col">
    <div class="card app-card app-card-hover h-100 border-0">
        <a asp-area="" asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none">
            <img src="@(string.IsNullOrEmpty(Model.ThumbnailUrl) ? "/images/course-dotnet.svg" : Model.ThumbnailUrl)"
                 alt="@Model.Title"
                 class="course-thumb" />
        </a>
        <div class="card-body d-flex flex-column p-3">
            <div class="d-flex justify-content-between align-items-center mb-2 gap-2">
                <span class="badge badge-orange rounded-pill text-truncate">@Model.CategoryName</span>
                <span class="small text-muted fw-medium">@Model.Level</span>
            </div>
            <h3 class="h6 fw-bold mb-2">
                <a asp-area="" asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Id" class="text-dark text-decoration-none stretched-link">
                    @Model.Title
                </a>
            </h3>
            <p class="small text-muted mb-3 flex-grow-1">@Model.ShortDescription</p>
            <div class="d-flex align-items-center justify-content-between small text-muted mb-2">
                <span><i class="bi bi-person-circle me-1 text-orange"></i>@Model.InstructorName</span>
                <span><i class="bi bi-people me-1"></i>@Model.StudentCount học viên</span>
            </div>
            <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                <div class="small fw-semibold">
                    @if (Model.ReviewCount > 0)
                    {
                        <span class="text-warning"><i class="bi bi-star-fill"></i></span>
                        <span>@Model.AverageRating.ToString("0.0")</span>
                        <span class="text-muted fw-normal">(@Model.ReviewCount)</span>
                    }
                    else
                    {
                        <span class="text-muted fw-normal">Chưa có đánh giá</span>
                    }
                </div>
                <div class="fw-bold text-orange fs-6">
                    @(Model.Price == 0 ? "Miễn phí" : $"{Model.Price:N0} đ")
                </div>
            </div>
        </div>
    </div>
</div>
