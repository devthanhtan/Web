@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<div class="row justify-content-center py-5" data-reveal="up">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="app-card p-4 p-md-5 text-center">
            <div class="stat-icon mx-auto mb-3">
                <i class="bi bi-exclamation-octagon-fill text-danger"></i>
            </div>
            <span class="badge badge-huit rounded-pill px-3 py-1 mb-2">HUIT Learning System</span>
            <h1 class="h3 fw-bold mb-2">Đã xảy ra sự cố khi xử lý yêu cầu</h1>
            <p class="text-muted mb-4">
                Hệ thống không thể hoàn tất thao tác vừa rồi. Vui lòng thử tải lại trang hoặc quay về trang chủ HUIT Learning.
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="bg-light border rounded-3 p-2 px-3 small text-muted mb-4 d-inline-block">
                    <strong>Mã truy vết (Request ID):</strong> <code>@Model.RequestId</code>
                </div>
            }

            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a class="btn btn-huit px-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door me-1"></i> Về trang chủ
                </a>
                <a class="btn btn-outline-orange px-4" asp-area="" asp-controller="Courses" asp-action="Index">
                    <i class="bi bi-compass me-1"></i> Xem khóa học
                </a>
            </div>
        </div>
    </div>
</div>
