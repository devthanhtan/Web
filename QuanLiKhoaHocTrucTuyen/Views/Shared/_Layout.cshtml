<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduSpark</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg app-navbar py-2">
            <div class="container">
                <a class="navbar-brand brand-mark" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon"><i class="bi bi-mortarboard-fill"></i></span>
                    <span>Edu<span class="text-orange">Spark</span></span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold text-dark" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        @await Component.InvokeAsync("CategoryMenu")
                        <li class="nav-item">
                            <a class="nav-link fw-semibold text-dark" asp-area="" asp-controller="Certificate" asp-action="Verify">Tra cứu chứng chỉ</a>
                        </li>
                    </ul>

                    <form class="d-flex me-lg-3 my-2 my-lg-0" asp-area="" asp-controller="Courses" asp-action="Index" method="get" role="search">
                        <div class="input-group input-group-sm">
                            <input class="form-control border-end-0" type="search" name="keyword" value="@Context.Request.Query["keyword"]" placeholder="Tìm khóa học..." aria-label="Tìm khóa học" />
                            <button class="btn btn-orange" type="submit" title="Tìm kiếm"><i class="bi bi-search"></i></button>
                        </div>
                    </form>

                    <div class="mt-2 mt-lg-0">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="py-4">
        <div class="container">
            <partial name="_AlertsPartial" />
            @RenderBody()
        </div>
    </main>

    <footer class="app-footer py-4">
        <div class="container">
            <div class="row gy-3 align-items-center">
                <div class="col-md-6">
                    <div class="brand-mark mb-1">
                        <span class="brand-icon" style="width:28px;height:28px;font-size:0.9rem;"><i class="bi bi-mortarboard-fill"></i></span>
                        <span class="fs-6">Edu<span class="text-orange">Spark</span></span>
                    </div>
                    <p class="small text-muted mb-0">Nền tảng bán và học khóa học trực tuyến chuẩn ASP.NET Core 8 MVC.</p>
                </div>
                <div class="col-md-6 text-md-end small text-muted">
                    <a class="me-3 text-muted" asp-area="" asp-controller="Courses" asp-action="Index">Khóa học</a>
                    <a class="me-3 text-muted" asp-area="" asp-controller="Certificate" asp-action="Verify">Xác thực chứng chỉ</a>
                    <span>&copy; 2026 EduSpark LMS</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
