@model int
@if (User.Identity?.IsAuthenticated == true)
{
    <a class="btn btn-light border position-relative rounded-pill px-3" asp-area="Student" asp-controller="Cart" asp-action="Index" title="Giỏ hàng">
        <i class="bi bi-cart3 text-orange"></i>
        <span class="d-none d-xl-inline ms-1 small fw-semibold">Giỏ hàng</span>
        @if (Model > 0)
        {
            <span id="navCartBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">@Model</span>
        }
        else
        {
            <span id="navCartBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">0</span>
        }
    </a>
}
